ry = sum / 10;\\n            curr.next = new ListNode(sum % 10);\\n            curr = curr.next;\\n        }\\n\\n        return dummy.next;\\n    }\\n}\\n","compare_result":"","title_slug":"add-two-numbers","has_notes":false,"flag_type":1,"frontend_id":53},{"id":1865996781,"question_id":279,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766768082,"status":10,"status_display":"Accepted","runtime":"38 ms","url":"/submissions/detail/1865996781/","is_pending":"Not Pending","title":"Perfect Squares","memory":"44.5 MB","code":"class Solution {\\n    public int numSquares(int n) {\\n        int[] dp = new int[n + 1];\\n        for (int i = 1; i <= n; i++) {\\n            dp[i] = i;\\n        }\\n\\n        for (int i = 1; i <= n; i++) {\\n            for (int j = 1; j * j <= i; j++) {\\n                int square = j * j;\\n                dp[i] = Math.min(dp[i], 1 + dp[i - square]);\\n            }\\n        }\\n\\n        return dp[n];\\n    }\\n}\\n","compare_result":"","title_slug":"perfect-squares","has_notes":null,"flag_type":1,"frontend_id":52},{"id":1865208525,"question_id":494,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766684418,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1865208525/","is_pending":"Not Pending","title":"Target Sum","memory":"43.1 MB","code":"class Solution {\\n    public int findTargetSumWays(int[] nums, int target) {\\n\\n        int sum = 0;\\n        for (int x : nums) sum += x;\\n\\n         if (Math.abs(target) > sum || (sum + target) % 2 != 0) \\n            return 0;\\n\\n        int newTarget = (sum + target) / 2;\\n\\n       \\n        int[] dp = new int[newTarget + 1];\\n        dp[0] = 1;\\n\\n        for (int num : nums) {\\n            for (int s = newTarget; s >= num; s--) {\\n                dp[s] += dp[s - num];\\n            }\\n        }\\n\\n        return dp[newTarget];\\n    }\\n}\\n","compare_result":"1