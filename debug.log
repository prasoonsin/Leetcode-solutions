_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780380819,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019829581/","is_pending":"Not Pending","title":"Two Sum II - Input Array Is Sorted","memory":"48 MB","code":"class Solution {\\n    public int[] twoSum(int[] numbers, int target) {\\n        int left = 0;\\n        int right = numbers.length - 1;\\n\\n        while (left < right) {\\n            int sum = numbers[left] + numbers[right];\\n\\n            if (sum == target) {\\n                return new int[]{left + 1, right + 1};\\n            } else if (sum < target) {\\n                left++;\\n            } else {\\n                right--;\\n            }\\n        }\\n\\n        return new int[]{-1, -1};\\n    }\\n}","compare_result":"111111111111111111111111","title_slug":"two-sum-ii-input-array-is-sorted","has_notes":false,"flag_type":1,"frontend_id":172},{"id":2019450570,"question_id":70,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780338564,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019450570/","is_pending":"Not Pending","title":"Climbing Stairs","memory":"42.1 MB","code":"class Solution {\\n    public int climbStairs(int n) {\\n\\n        if (n <= 2) {\\n            return n;\\n        }\\n\\n        int first = 1;\\n        int second = 2;\\n\\n        for (int i = 3; i <= n; i++) {\\n            int current = first + second;\\n            first = second;\\n            second = current;\\n        }\\n\\n        return second;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111","title_slug":"climbing-stairs","has_notes":false,"flag_type":1,"frontend_id":171},{"id":2019433608,"question_id":239,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780337644,"status":10,"status_display":"Accepted","runtime":"32 ms","url":"/submissions/detail/2019433608/","is_pending":"Not Pending","title":"Sliding Window Maximum","memory":"155.9 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public int[] maxSlidingWindow(int[] nums, int k) {\\n        Deque<Integer> dq = new LinkedList<>();\\n        int[] result = new int[nums.length - k + 1];\\n        int index = 0;\\n\\n        for (int i = 0; i < nums.length; i++) {\\n\\n            while (!dq.isEmpty() && dq.peekFirst() <= i - k) {\\n                dq.pollFirst();\\n            }\\n\\n            while (!dq.isEmpty() && nums[dq.peekLast()] < nums[i]) {\\n                dq.pollLast();\\n            }\\n\\n            dq.offerLast(i);\\n\\n            if (i >= k - 1) {\\n                result[index++] = nums[dq.peekFirst()];\\n            }\\n        }\\n\\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111","title_slug":"sliding-window-maximum","has_notes":false,"flag_type":1,"frontend_id":170},{"id":2019432233,"question_id":84,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780337570,"status":10,"status_display":"Accepted","runtime":"69 ms","url":"/submissions/detail/2019432233/","is_pending":"Not Pending","title":"Largest Rectangle in Histogram","memory":"78.1 MB","code":"import java.util.Stack;\\n\\nclass Solution {\\n    public int largestRectangleArea(int[] heights) {\\n        Stack<Integer> stack = new Stack<>();\\n        int maxArea = 0;\\n        int n = heights.length;\\n\\n        for (int i = 0; i <= n; i++) {\\n            int h = (i == n) ? 0 : heights[i];\\n\\n            while (!stack.isEmpty() && h < heights[stack.peek()]) {\\n                int height = heights[stack.pop()];\\n                int width = stack.isEmpty() ? i : i - stack.peek() - 1;\\n                maxArea = Math.max(maxArea, height * width);\\n            }\\n\\n            stack.push(i);\\n        }\\n\\n        return maxArea;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"largest-rectangle-in-histogram","has_notes":false,"flag_type":1,"frontend_id":169},{"id":2019421398,"question_id":42,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780337008,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019421398/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"47.3 MB","code":"class Solution {\\n    public int trap(int[] height) {\\n        int left = 0;\\n        int right = height.length - 1;\\n        int leftMax = 0;\\n        int rightMax = 0;\\n        int water = 0;\\n\\n        while (left < right) {\\n            if (height[left] < height[right]) {\\n                if (height[left] >= leftMax) {\\n                    leftMax = height[left];\\n                } else {\\n                    water += leftMax - height[left];\\n                }\\n                left++;\\n            } else {\\n                if (height[right] >= rightMax) {\\n                    rightMax = height[right];\\n                } else {\\n                    water += rightMax - height[right];\\n                }\\n                right--;\\n            }\\n        }\\n\\n        return water;\\n    }\\n}","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":168},{"id":2019418681,"question_id":231,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780336868,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2019418681/","is_pending":"Not Pending","title":"Power of Two","memory":"42.3 MB","code":"class Solution {\\n    public boolean isPowerOfTwo(int n) {\\n        return n > 0 && (n & (n - 1)) == 0;\\n    }\\n}","compare_result":"","title_slug":"power-of-two","has_notes":false,"flag_type":1,"frontend_id":167},{"id":1992781338,"question_id":1528,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1777657888,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1992781338/","is_pending":"Not Pending","title":"Kids With the Greatest Number of Candies","memory":"44 MB","code":"class Solution {\\n    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {\\n        \\n        List<Boolean> result = new ArrayList<>();\\n\\n        int max = 0;\\n        for (int c : candies) {\\n            max = Math.max(max, c);\\n        }\\n\\n        for (int c : candies) {\\n            result.add(c + extraCandies >= max);\\n        }\\n\\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"kids-with-the-greatest-number-of-candies","has_notes":false,"flag_type":1,"frontend_id":166},{"id":1986457867,"question_id":72,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776971155,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1986457867/","is_pending":"Not Pending","title":"Edit Distance","memory":"47.1 MB","code":"class Solution {\\n    public int minDistance(String word1, String word2) {\\n\\n        int m = word1.length();\\n        int n = word2.length();\\n\\n        int[][] dp = new int[m+1][n+1];\\n\\n        for (int i = 0; i <= m; i++) dp[i][0] = i;\\n        for (int j = 0; j <= n; j++) dp[0][j] = j;\\n\\n        for (int i = 1; i <= m; i++) {\\n            for (int j = 1; j <= n; j++) {\\n\\n                if (word1.charAt(i-1) == word2.charAt(j-1)) {\\n                    dp[i][j] = dp[i-1][j-1];\\n                } else {\\n                    dp[i][j] = 1 + Math.min(\\n                        dp[i-1][j],\\n                        Math.min(dp[i][j-1], dp[i-1][j-1])\\n                    );\\n                }\\n            }\\n        }\\n\\n        return dp[m][n];\\n    }\\n}","compare_result":"","title_slug":"edit-distance","has_notes":false,"flag_type":1,"frontend_id":165},{"id":1981976775,"question_id":104,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1776535786,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1981976775/","is_pending":"Not Pending","title":"Maximum Depth of Binary Tree","memory":"44.5 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    public int maxDepth(TreeNode root) {\\n        if (root == null) return 0;\\n        int left = maxDepth(root.left);\\n        int right = maxDepth(root.right);\\n        return 1 + Math.max(left, right);\\n    }\\n}","compare_result":"111111111111111111111111111111111111111","title_slug":"maximum-depth-of-binary-tree","has_notes":false,"flag_type":1,"frontend_id":164},{"id":1981976533,"question_id":104,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1776535768,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1981976533/","is_pending":"Not Pending","title":"Maximum Depth of Binary Tree","memory":"44.7 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    public int maxDepth(TreeNode root) {\\n        if (