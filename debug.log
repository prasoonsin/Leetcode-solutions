on {\\n    public int[] intersect(int[] nums1, int[] nums2) {\\n\\n        HashMap<Integer, Integer> freq = new HashMap<>();\\n\\n        // Count frequency of nums1\\n        for (int num : nums1) {\\n            freq.put(num, freq.getOrDefault(num, 0) + 1);\\n        }\\n\\n        List<Integer> result = new ArrayList<>();\\n\\n        // Check nums2 against the map\\n        for (int num : nums2) {\\n            if (freq.containsKey(num) && freq.get(num) > 0) {\\n                result.add(num);\\n                freq.put(num, freq.get(num) - 1);\\n            }\\n        }\\n\\n        // Convert list to array\\n        int[] ans = new int[result.size()];\\n        for (int i = 0; i < result.size(); i++) {\\n            ans[i] = result.get(i);\\n        }\\n\\n        return ans;\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111","title_slug":"intersection-of-two-arrays-ii","has_notes":false,"flag_type":1,"frontend_id":72},{"id":1887603709,"question_id":189,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768643396,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887603709/","is_pending":"Not Pending","title":"Rotate Array","memory":"61.4 MB","code":"class Solution {\\n    public void rotate(int[] nums, int k) {\\n        int n = nums.length;\\n        k = k % n;\\n\\n        reverse(nums, 0, n - 1);\\n        reverse(nums, 0, k - 1);\\n        reverse(nums, k, n - 1);\\n    }\\n\\n    private void reverse(int[] nums, int left, int right) {\\n        while (left < right) {\\n            int temp = nums[left];\\n            nums[left] = nums[right];\\n            nums[right] = temp;\\n            left++;\\n            right--;\\n        }\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111","title_slug":"rotate-array","has_notes":false,"flag_type":1,"frontend_id":71},{"id":1887602953,"question_id":88,"lang":"java","lang_na