   if (set1.contains(num)) {\\n            result.add(num);\\n        }\\n       }\\n       int[] ans = new int[result.size()];\\n       int  index = 0;\\n       for (int num : result) {\\n        ans[index] = num;\\n        index++;\\n       }\\n       return ans;\\n\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111","title_slug":"intersection-of-two-arrays","has_notes":false,"flag_type":1,"frontend_id":196},{"id":2066395650,"question_id":268,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1783960836,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2066395650/","is_pending":"Not Pending","title":"Missing Number","memory":"47.4 MB","code":"class Solution {\\n    public int missingNumber(int[] nums) {\\n        int n = nums.length;\\n        int expectedSum = n*(n+1)/2;\\n        int actualSum = 0;\\n        for (int i =0; i<n; i++) {\\n            actualSum += nums[i];\\n        }\\n        return expectedSum-actualSum;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"missing-number","has_notes":false,"flag_type":1,"frontend_id":195}],"has_next":true,"last_key":""}'
