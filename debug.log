f (nums[i] != nums[i + 1]) {\\n                distinct++;\\n                if (distinct == 3) return nums[i];\\n            }\\n        }\\n        return nums[nums.length - 1];\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111","title_slug":"third-maximum-number","has_notes":false,"flag_type":1,"frontend_id":103},{"id":1888938752,"question_id":1217,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768745681,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1888938752/","is_pending":"Not Pending","title":"Relative Sort Array","memory":"44.2 MB","code":"class Solution {\\n    public int[] relativeSortArray(int[] arr1, int[] arr2) {\\n        Map<Integer, Integer> map = new HashMap<>();\\n        for (int x : arr1) map.put(x, map.getOrDefault(x, 0) + 1);\\n\\n        int idx = 0;\\n        for (int x : arr2)\\n            while (map.getOrDefault(x, 0) > 0) {\\n                arr1[idx++] = x;\\n                map.put(x, map.get(x) - 1);\\n            }\\n\\n        List<Integer> rest = new ArrayList<>();\\n        for (int x : map.keySet())\\n            while (map.get(x) > 0) {\\n                rest.add(x);\\n                map.put(x, map.get(x) - 1);\\n            }\\n\\n        Collections.sort(rest);\\n        for (int x : rest) arr1[idx++] = x;\\n        return arr1;\\n    }\\n}\\n","compare_result":"11111111111111111","title_slug":"relative-sort-array","has_notes":false,"flag_type":1,"frontend_id":102},{"id":1888938117,"question_id":1018,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768745639,"status":10,"status_display":"Accepted","runtime":"12 ms","url":"/submissions/detail/1888938117/","is_pending":"Not Pending","title":"Largest Perimeter Triangle","memory":"47.8 MB","code":"class Solution {\\n    public int largestPerimeter(int[] nums) {\\n        Arrays.sort(nums);\\n        for (int i = nums.length - 1; i >= 2; i--)\\n    