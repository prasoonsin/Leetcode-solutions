timestamp":1768746494,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1888950982/","is_pending":"Not Pending","title":"Length of Last Word","memory":"N/A","code":"class Solution {\\n    public int lengthOfLastWord(String s) {\\n        int len = 0;\\n        for (int i = s.length() - 1; i >= 0 && s.charAt(i) != \' \'; i--)\\n            len++;\\n        return len;\\n    }\\n}\\n","compare_result":"101110000101011101011111111111111111100101111001001000010001","title_slug":"length-of-last-word","has_notes":false,"flag_type":1,"frontend_id":126},{"id":1888950642,"question_id":125,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746469,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1888950642/","is_pending":"Not Pending","title":"Valid Palindrome","memory":"44 MB","code":"class Solution {\\n    public boolean isPalindrome(String s) {\\n        int l = 0, r = s.length() - 1;\\n        while (l < r) {\\n            while (l < r && !Character.isLetterOrDigit(s.charAt(l))) l++;\\n            while (l < r && !Character.isLetterOrDigit(s.charAt(r))) r--;\\n            if (Character.toLowerCase(s.charAt(l)) !=\\n                Character.toLowerCase(s.charAt(r))) return false;\\n            l++; r--;\\n        }\\n        return true;\\n    }\\n}\\n","compare_result":"","title_slug":"valid-palindrome","has_notes":false,"flag_type":1,"frontend_id":125},{"id":1888950304,"question_id":344,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746446,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888950304/","is_pending":"Not Pending","title":"Reverse String","memory":"48.3 MB","code":"class Solution {\\n    public void reverseString(char[] s) {\\n        int l = 0, r = s.length - 1;\\n        while (l < r) {\\n            char t = s[l];\\n            s[l] = s[r];\\n            s[r] = t;\\n            l++; r--;\\n        }\\n    }\\n}\\n","compare_result":"","title_slug":"reverse-string","has_notes":false,"flag_type":1,"frontend_id":124},{"id":1888949549,"question_id":300,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746393,"status":10,"status_display":"Accepted","runtime":"37 ms","url":"/submissions/detail/1888949549/","is_pending":"Not Pending","title":"Longest Increasing Subsequence","memory":"46.3 MB","code":"class Solution {\\n    public int lengthOfLIS(int[] nums) {\\n        int[] dp = new int[nums.length];\\n        Arrays.fill(dp, 1);\\n        int max = 1;\\n\\n        for (int i = 1; i < nums.length; i++)\\n            for (int j = 0; j < i; j++)\\n                if (nums[i] > nums[j])\\n                    dp[i] = Math.max(dp[i], dp[j] + 1);\\n\\n        for (int x : dp) max = Math.max(max, x);\\n        return max;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111","title_slug":"longest-increasing-subsequence","has_notes":false,"flag_type":1,"frontend_id":123},{"id":1888949153,"question_id":322,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746365,"status":10,"status_display":"Accepted","runtime":"16 ms","url":"/submissions/detail/1888949153/","is_pending":"Not Pending","title":"Coin Change","memory":"46.3 MB","code":"class Solution {\\n    public int coinChange(int[] coins, int amount) {\\n        int[] dp = new int[amount + 1];\\n        Arrays.fill(dp, amount + 1);\\n        dp[0] = 0;\\n        for (int i = 1; i <= amount; i++) {\\n            for (int coin : coins) {\\n                if (coin <= i) {\\n                    dp[i] = Math.min(dp[i], dp[i - coin] +1);\\n                }\\n            }\\n        }\\n        return dp[amount] > amount ? -1 : dp[amount];\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"coin-change","has_notes":false,"flag_type":1,"frontend_id":122},{"id":1888948521,"question_id":560,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746322,"status":10,"status_display":"Accepted","runtime":"25 ms","url":"/submissions/detail/1888948521/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"48.9 MB","code":"class Solution {\\n    public int subarraySum(int[] nums, int k) {\\n        Map<Integer, Integer> map = new HashMap<>();\\n        map.put(0, 1);\\n\\n        int sum = 0, count = 0;\\n        for (int n : nums) {\\n            sum += n;\\n            count += map.getOrDefault(sum - k, 0);\\n            map.put(sum, map.getOrDefault(sum, 0) + 1);\\n        }\\n        return count;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":121},{"id":1888948180,"question_id":347,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746300,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1888948180/","is_pending":"Not Pending","title":"Top K Frequent Elements","memory":"47.7 MB","code":"class Solution {\\n    public int[] topKFrequent(int[] nums, int k) {\\n        Map<Integer, Integer> freq = new HashMap<>();\\n        for (int n : nums) freq.put(n, freq.getOrDefault(n, 0) + 1);\\n\\n        List<Integer>[] bucket = new List[nums.length + 1];\\n        for (int key : freq.keySet()) {\\n            int f = freq.get(key);\\n            if (bucket[f] == null) bucket[f] = new ArrayList<>();\\n            bucket[f].add(key);\\n        }\\n\\n        List<Integer> res = new ArrayList<>();\\n        for (int i = bucket.length - 1; i >= 0 && res.size() < k; i--)\\n            if (bucket[i] != null) res.addAll(bucket[i]);\\n\\n        return res.stream().mapToInt(i -> i).limit(k).toArray();\\n    }\\n}\\n","compare_result":"11111111111111111111111","title_slug":"top-k-frequent-elements","has_notes":false,"flag_type":1,"frontend_id":120},{"id":1888946379,"question_id":543,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746179,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1888946379/","is_pending":"Not Pending","title":"Diameter of Binary Tree","memory":"47 MB","code":"class Solution {\\n    int max = 0;\\n\\n    public int diameterOfBinaryTree(TreeNode root) {\\n        depth(root);\\n        return max;\\n    }\\n\\n    int depth(TreeNode node) {\\n        if (node == null) return 0;\\n        int left = depth(node.left);\\n        int right = depth(node.right);\\n        max = Math.max(max, left + right);\\n        return 1 + Math.max(left, right);\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"diameter-of-binary-tree","has_notes":false,"flag_type":1,"frontend_id":119},{"id":1888946076,"question_id":617,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746157,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888946076/","is_pending":"Not Pending","title":"Merge Two Binary Trees","memory":"46.9 MB","code":"class Solution {\\n    public TreeNode mergeTrees(TreeNode t1, TreeNode t2) {\\n        if (t1 == null) return t2;\\n        if (t2 == null) return t1;\\n\\n        t1.val += t2.val;\\n        t1.left = mergeTrees(t1.left, t2.left);\\n        t1.right = mergeTrees(t1.right, t2.right);\\n\\n        return t1;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-two-binary-trees","has_notes":false,"flag_type":1,"frontend_id":118},{"id":1888945667,"question_id":975,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746131,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888945667/","is_pending":"Not Pending","title":"Range Sum of BST","memory":"54 MB","code":"class Solution {\\n    public int rangeSumBST(TreeNode root, int low, int high) {\\n        if (root == null) return 0;\\n\\n        if (root.val < low)\\n            return rangeSumBST(root.right, low, high);\\n        if (root.val > high)\\n            return rangeSumBST(root.left, low, high);\\n\\n        return root.val +\\n               rangeSumBST(root.left, low, high) +\\n               rangeSumBST(root.right, low, high);\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111","title_slug":"range-sum-of-bst","has_notes":false,"flag_type":1,"frontend_id":117},{"id":1888945190,"question_id":783,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746101,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888945190/","is_pending":"Not Pending","title":"Search in a Binary Search Tree","memory":"47.2 MB","code":"class Solution {\\n    public TreeNode searchBST(TreeNode root, int val) {\\n        if (root == null || root.val == val) return root;\\n        if (val < root.val) return searchBST(root.left, val);\\n        return searchBST(root.right, val);\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111","title_slug":"search-in-a-binary-search-tree","has_notes":false,"flag_type":1,"frontend_id":116},{"id":1888944845,"question_id":235,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768746077,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/1888944845/","is_pending":"Not Pending","title":"Lowest Common Ancestor of a Binary Search Tree","memory":"47.8 MB","code":"class Solution {\\n    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {\\n        if (root == null) return null;\\n\\n        if (p.val < root.val && q.val < root.val)\\n            return lowestCommonAncestor(root.left, p, q);\\n        if (p.val > root.val && q.val > root.val)\\n            return lowestCommonAncestor(root.right, p, q);\\n\\n        return root;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111","title_slug":"lowest-common-ancestor-of-a-binary-search-tree","has_notes":false,"flag_type":1,"frontend_id":115}],"has_next":true,"last_key":""}'
