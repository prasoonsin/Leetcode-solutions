my = new ListNode(0);\\n        ListNode curr = dummy;\\n\\n        while (!pq.isEmpty()) {\\n            ListNode node = pq.poll();\\n            curr.next = node;\\n            curr = curr.next;\\n\\n            if (node.next != null) {\\n                pq.offer(node.next);\\n            }\\n        }\\n\\n        return dummy.next;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-k-sorted-lists","has_notes":false,"flag_type":1,"frontend_id":49},{"id":1862610537,"question_id":62,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766423087,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1862610537/","is_pending":"Not Pending","title":"Unique Paths","memory":"42.4 MB","code":"class Solution {\\n    public int uniquePaths(int m, int n) {\\n\\n        int[][] dp = new int[m][n];\\n\\n        // First row: only one way (move right)\\n        for (int j = 0; j < n; j++) {\\n            dp[0][j] = 1;\\n        }\\n\\n        // First column: only one way (move down)\\n        for (int i = 0; i < m; i++) {\\n            dp[i][0] = 1;\\n        }\\n\\n        // Fill the rest of the grid\\n        for (int i = 1; i < m; i++) {\\n            for (int j = 1; j < n; j++) {\\n                dp[i][j] = dp[i - 1][j] + dp[i][j - 1];\\n            }\\n        }\\n\\n        return dp[m - 1][n - 1];\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111","title_slug":"unique-paths","has_notes":false,"flag_type":1,"frontend_id":48},{"id":1862607929,"question_id":62,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766422924,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1862607929/","is_pending":"Not Pending","title":"Unique Paths","memory":"42.1 MB","code":"class Solution {\\n    public int uniquePaths(int m, int n) {\\n\\n        int[][] dp = new int[m][n];\\n\\n        // First row: only one way (move right)\\n        for (int j = 0; j < n; j++) {\\n            dp[0][j] = 1;\\n        }\\n\\n        // First column: only one way (move down)\\n        for (int i = 0; i < m; i++) {\\n            dp[i][0] = 1;\\n        }\\n\\n        // Fill the rest of the grid\\n        for (int i = 1; i < m; i++) {\\n            for (int j = 1; j < n; j++) {\\n                dp[i][j] = dp[i - 1][j] + dp[i][j - 1];\\n            }\\n        }\\n\\n        return dp[m - 1][n - 1];\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111","title_slug":"unique-paths","has_notes":false,"flag_type":1,"frontend_id":47},{"id":1861754450,"question_id":7,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766338114,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1861754450/","is_pending":"Not Pending","title":"Reverse Integer","memory":"42.9 MB","code":"class Solution {\\n    public int reverse(int x) {\\n        int rev = 0;\\n\\n        while (x != 0) {\\n            int digit = x % 10;   \\n            x = x / 10;           \\n\\n         \\n            if (rev > Integer.MAX_VALUE / 10 || \\n               (rev == Integer.MAX_VALUE / 10 && digit > 7)) {\\n                return 0;\\n            }\\n\\n            if (rev < Integer.MIN_VALUE / 10 || \\n               (rev == Integer.MIN_VALUE / 10 && digit < -8)) {\\n                return 0;\\n            }\\n\\n            rev = rev * 10 + digit; \\n        }\\n\\n        return rev;\\n    }\\n}\\n","compare_result":"","title_slug":"reverse-integer","has_notes":false,"flag_type":1,"frontend_id":46},{"id":1860821838,"question_id":6,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766248022,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/1860821838/","is_pending":"Not Pending","title":"Zigzag Conversion","memory":"46.7 MB","code":"class Solution {\\n    public String convert(String s, int numRows) {\\n        // Edge case: no zigzag possible\\n        if (numRows == 1 || s.length() <= numRows) {\\n            return s;\\n        }\\n\\n        // Create StringBuilder for each row\\n        StringBuilder[] rows = new StringBuilder[numRows];\\n        for (int i = 0; i < numRows; i++) {\\n            rows[i] = new StringBuilder();\\n        }\\n\\n        int currentRow = 0;\\n        boolean goingDown = false;\\n\\n        // Traverse characters\\n        for (char c : s.toCharArray()) {\\n            rows[currentRow].append(c);\\n\\n            // Change direction at top or bottom\\n            if (currentRow == 0 || currentRow == numRows - 1) {\\n                goingDown = !goingDown;\\n            }\\n\\n            currentRow += goingDown ? 1 : -1;\\n        }\\n\\n        // Combine all rows\\n        StringBuilder result = new StringBuilder();\\n        for (StringBuilder row : rows) {\\n            result.append(row);\\n        }\\n\\n        return result.toString();\\n    }\\n}","compare_result":"","title_slug":"zigzag-conversion","has_notes":false,"flag_type":1,"frontend_id":45},{"id":1860821704,"question_id":6,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1766248014,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/1860821704/","is_pending":"Not Pending","title":"Zigzag Conversion","memory":"46.8 MB","code":"class Solution {\\n    public String convert(String s, int numRows) {\\n        // Edge case: no zigzag possible\\n        if (numRows == 1 || s.length() <= numRows) {\\n            return s;\\n        }\\n\\n        // Create StringBuilder for each row\\n        StringBuilder[] rows = new StringBuilder[numRows];\\n        for (int i = 0; i < numRows; i++) {\\n            rows