rontend_id":93},{"id":1888913657,"question_id":1570,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768744015,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/1888913657/","is_pending":"Not Pending","title":"Final Prices With a Special Discount in a Shop","memory":"45.6 MB","code":"import java.util.Stack;\\n\\nclass Solution {\\n    public int[] finalPrices(int[] prices) {\\n        int n = prices.length;\\n        int[] ans = new int[n];\\n        Stack<Integer> stack = new Stack<>();\\n\\n        for (int i = n - 1; i >= 0; i--) {\\n            while (!stack.isEmpty() && stack.peek() > prices[i]) {\\n                stack.pop();\\n            }\\n            ans[i] = stack.isEmpty() ? prices[i] : prices[i] - stack.peek();\\n            stack.push(prices[i]);\\n        }\\n\\n        return ans;\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"final-prices-with-a-special-discount-in-a-shop","has_notes":false,"flag_type":1,"frontend_id":92},{"id":1888912981,"question_id":1128,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743970,"status":10,"status_display":"Accepted","runtime":"25 ms","url":"/submissions/detail/1888912981/","is_pending":"Not Pending","title":"Remove All Adjacent Duplicates In String","memory":"46.9 MB","code":"import java.util.Stack;\\n\\nclass Solution {\\n    public String removeDuplicates(String s) {\\n        Stack<Character> stack = new Stack<>();\\n\\n        for (char c : s.toCharArray()) {\\n            if (!stack.isEmpty() && stack.peek() == c) {\\n                stack.pop();\\n            } else {\\n                stack.push(c);\\n            }\\n        }\\n\\n        StringBuilder sb = new StringBuilder();\\n        for (char c : stack) {\\n            sb.append(c);\\n        }\\n\\n        return sb.toString();\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"remove-all-adjacent-duplicates-in-string","has_notes":false,"flag_type":1,"frontend_id":91},{"id":1888912194,"question_id":874,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743921,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888912194/","is_pending":"Not Pending","title":"Backspace String Compare","memory":"43.2 MB","code":"class Solution {\\n    public boolean backspaceCompare(String s, String t) {\\n        int i = s.length() - 1, j = t.length() - 1;\\n        int skipS = 0, skipT = 0;\\n\\n        while (i >= 0 || j >= 0) {\\n\\n            while (i >= 0) {\\n                if (s.charAt(i) == \'#\') {\\n                    skipS++;\\n                    i--;\\n                } else if (skipS > 0) {\\n                    skipS--;\\n                    i--;\\n                } else break;\\n            }\\n\\n            while (j >= 0) {\\n                if (t.charAt(j) == \'#\') {\\n                    skipT++;\\n                    j--;\\n                } else if (skipT > 0) {\\n                    skipT--;\\n                    j--;\\n                } else break;\\n            }\\n\\n            char c1 = i >= 0 ? s.charAt(i) : \'\\\\0\';\\n            char c2 = j >= 0 ? t.charAt(j) : \'\\\\0\';\\n\\n            if (c1 != c2) return false;\\n\\n            i--;\\n            j--;\\n        }\\n\\n        return true;\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"backspace-string-compare","has_notes":false,"flag_type":1,"frontend_id":90},{"id":1888910936,"question_id":496,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743832,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/1888910936/","is_pending":"Not Pending","title":"Next Greater Element I","memory":"45.4 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public int[] nextGreaterElement(int[] nums1, int[] nums2) {\\n\\n        Map<Integer, Integer> map = new HashMap<>();\\n        Stack<Integer> stack = new Stack<>();\\n\\n        for (int num : nums2) {\\n            while (!stack.isEmpty() && stack.peek() < num) {\\n                map.put(stack.pop(), num);\\n            }\\n            stack.push(num);\\n        }\\n\\n        int[] ans = new int[nums1.length];\\n        for (int i = 0; i < nums1.length; i++) {\\n            ans[i] = map.getOrDefault(nums1[i], -1);\\n        }\\n\\n        return ans;\\n    }\\n}\\n","compare_result":"11111111111111111","title_slug":"next-greater-element-i","has_notes":false,"flag_type":1,"frontend_id":89},{"id":1888910149,"question_id":682,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743780,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1888910149/","is_pending":"Not Pending","title":"Baseball Game","memory":"43.6 MB","code":"import java.util.Stack;\\n\\nclass Solution {\\n    public int calPoints(String[] ops) {\\n        Stack<Integer> stack = new Stack<>();\\n\\n        for (String op : ops) {\\n            if (op.equals(\\"C\\")) {\\n                stack.pop();\\n            } else if (op.equals(\\"D\\")) {\\n                stack.push(stack.peek() * 2);\\n            } else if (op.equals(\\"+\\")) {\\n                int top = stack.pop();\\n                int newTop = top + stack.peek();\\n                stack.push(top);\\n                stack.push(newTop);\\n            } else {\\n                stack.push(Integer.parseInt(op));\\n            }\\n        }\\n\\n        int sum = 0;\\n        for (int val : stack) {\\n            sum += val;\\n        }\\n\\n        return sum;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111","title_slug":"baseball-game","has_notes":false,"flag_type":1,"frontend_id":88},{"id":1888909352,"question_id":225,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743721,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888909352/","is_pending":"Not Pending","title":"Implement Stack using Queues","memory":"42.9 MB","code":"import java.util.LinkedList;\\nimport java.util.Queue;\\n\\nclass MyStack {\\n\\n    private Queue<Integer> q1;\\n    private Queue<Integer> q2;\\n\\n    public MyStack() {\\n        q1 = new LinkedList<>();\\n        q2 = new LinkedList<>();\\n    }\\n\\n    public void push(int x) {\\n        q2.offer(x);\\n        while (!q1.isEmpty()) {\\n            q2.offer(q1.poll());\\n        }\\n        Queue<Integer> temp = q1;\\n        q1 = q2;\\n        q2 = temp;\\n    }\\n\\n    public int pop() {\\n        return q1.poll();\\n    }\\n\\n    public int top() {\\n        return q1.peek();\\n    }\\n\\n    public boolean empty() {\\n        return q1.isEmpty();\\n    }\\n}\\n","compare_result":"111111111111111111","title_slug":"implement-stack-using-queues","has_notes":false,"flag_type":1,"frontend_id":87},{"id":1888908015,"question_id":232,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743632,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1888908015/","is_pending":"Not Pending","title":"Implement Queue using Stacks","memory":"42.8 MB","code":"import java.util.Stack;\\n\\nclass MyQueue {\\n\\n    private Stack<Integer> inStack;\\n    private Stack<Integer> outStack;\\n\\n    public MyQueue() {\\n        inStack = new Stack<>();\\n        outStack = new Stack<>();\\n    }\\n\\n    public void push(int x) {\\n        inStack.push(x);\\n    }\\n\\n    public int pop() {\\n        shift();\\n        return outStack.pop();\\n    }\\n\\n    public int peek() {\\n        shift();\\n        return outStack.peek();\\n    }\\n\\n    public boolean empty() {\\n        return inStack.isEmpty() && outStack.isEmpty();\\n    }\\n\\n    private void shift() {\\n        if (outStack.isEmpty()) {\\n            while (!inStack.isEmpty()) {\\n                outStack.push(inStack.pop());\\n            }\\n        }\\n    }\\n}\\n","compare_result":"1111111111111111111111","title_slug":"implement-queue-using-stacks","has_notes":false,"flag_type":1,"frontend_id":86},{"id":1888905811,"question_id":155,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743478,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1888905811/","is_pending":"Not Pending","title":"Min Stack","memory":"47.1 MB","code":"import java.util.Stack;\\n\\nclass MinStack {\\n\\n    private Stack<Integer> stack;\\n    private Stack<Integer> minStack;\\n\\n    public MinStack() {\\n        stack = new Stack<>();\\n        minStack = new Stack<>();\\n    }\\n\\n    public void push(int val) {\\n        stack.push(val);\\n\\n        // push the new min\\n        if (minStack.isEmpty() || val <= minStack.peek()) {\\n            minStack.push(val);\\n        } else {\\n            minStack.push(minStack.peek());\\n        }\\n    }\\n\\n    public void pop() {\\n        stack.pop();\\n        minStack.pop();\\n    }\\n\\n    public int top() {\\n        return stack.peek();\\n    }\\n\\n    public int getMin() {\\n        return minStack.peek();\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111","title_slug":"min-stack","has_notes":false,"flag_type":1,"frontend_id":85},{"id":1888903973,"question_id":20,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768743346,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1888903973/","is_pending":"Not Pending","title":"Valid Parentheses","memory":"43.5 MB","code":"import java.util.Stack;\\n\\nclass Solution {\\n    public boolean isValid(String s) {\\n        Stack<Character> stack = new Stack<>();\\n\\n        for (char ch : s.toCharArray()) {\\n\\n            \\n            if (ch == \'(\' || ch == \'{\' || ch == \'[\') {\\n                stack.push(ch);\\n            } \\n           \\n            else {\\n                if (stack.isEmpty()) return false;\\n\\n                char top = stack.pop();\\n\\n                if (ch == \')\' && top != \'(\') return false;\\n                if (ch == \'}\' && top != \'{\') return false;\\n                if (ch == \']\' && top != \'[\') return false;\\n            }\\n        }\\n\\n     \\n        return stack.isEmpty();\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"valid-parentheses","has_notes":false,"flag_type":1,"frontend_id":84},{"id":1887615830,"question_id":203,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768644321,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1887615830/","is_pending":"Not Pending","title":"Remove Linked List Elements","memory":"47.4 MB","code":"class Solution {\\n    public ListNode removeElements(ListNode head, int val) {\\n        ListNode dummy = new ListNode(0);\\n        dummy.next = head;\\n\\n        ListNode current = dummy;\\n\\n        while (current.next != null) {\\n            if (current.next.val == val) {\\n                current.next = current.next.next; // remove node\\n            } else {\\n                current = current.next;\\n            }\\n        }\\n\\n        return dummy.next;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111","title_slug":"remove-linked-list-elements","has_notes":false,"flag_type":1,"frontend_id":83},{"id":1887614800,"question_id":160,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768644243,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1887614800/","is_pending":"Not Pending","title":"Intersection of Two Linked Lists","memory":"53.2 MB","code":"class Solution {\\n    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {\\n        if (headA == null || headB == null) return null;\\n\\n        ListNode a = headA;\\n        ListNode b = headB;\\n\\n        while (a != b) {\\n            a = (a == null) ? headB : a.next;\\n            b = (b == null) ? headA : b.next;\\n        }\\n\\n        return a; // intersection node or null\\n    }\\n}\\n\\n","compare_result":"11111111111111111111111111111111111111111","title_slug":"intersection-of-two-linked-lists","has_notes":false,"flag_type":1,"frontend_id":82},{"id":1887613903,"question_id":141,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768644180,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887613903/","is_pending":"Not Pending","title":"Linked List Cycle","memory":"46.8 MB","code":"class Solution {\\n    public boolean hasCycle(ListNode head) {\\n        if (head == null) return false;\\n\\n        ListNode slow = head;\\n        ListNode fast = head;\\n\\n        while (fast != null && fast.next != null) {\\n            slow = slow.next;\\n            fast = fast.next.next;\\n\\n            if (slow == fast) {\\n                return true; // cycle detected\\n            }\\n        }\\n\\n        return false; // reached the end\\n    }\\n}\\n","compare_result":"11111111111111111111111111111","title_slug":"linked-list-cycle","has_notes":false,"flag_type":1,"frontend_id":81},{"id":1887612546,"question_id":21,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768644078,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887612546/","is_pending":"Not Pending","title":"Merge Two Sorted Lists","memory":"44.4 MB","code":"class Solution {\\n    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {\\n        ListNode dummy = new ListNode(-1);\\n        ListNode tail = dummy;\\n\\n        while (list1 != null && list2 != null) {\\n            if (list1.val <= list2.val) {\\n                tail.next = list1;\\n                list1 = list1.next;\\n            } else {\\n                tail.next = list2;\\n                list2 = list2.next;\\n            }\\n            tail = tail.next;\\n        }\\n\\n        // attach remaining nodes\\n        tail.next = (list1 != null) ? list1 : list2;\\n\\n        return dummy.next;\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-two-sorted-lists","has_notes":false,"flag_type":1,"frontend_id":80},{"id":1887611635,"question_id":908,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768644014,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887611635/","is_pending":"Not Pending","title":"Middle of the Linked List","memory":"43 MB","code":"class Solution {\\n    public ListNode middleNode(ListNode head) {\\n        ListNode slow = head;\\n        ListNode fast = head;\\n\\n        while (fast != null && fast.next != null) {\\n            slow = slow.next;\\n            fast = fast.next.next;\\n        }\\n\\n        return slow;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111","title_slug":"middle-of-the-linked-list","has_notes":false,"flag_type":1,"frontend_id":79},{"id":1887610980,"question_id":206,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768643964,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887610980/","is_pending":"Not Pending","title":"Reverse Linked List","memory":"44.2 MB","code":"class Solution {\\n    public ListNode reverseList(ListNode head) {\\n        ListNode prev = null;\\n        ListNode curr = head;\\n\\n        while (curr != null) {\\n            ListNode next = curr.next; // save next\\n            curr.next = prev;          // reverse link\\n            prev = curr;               // move prev\\n            curr = next;               // move curr\\n        }\\n\\n        return prev;\\n    }\\n}\\n","compare_result":"1111111111111111111111111111","title_slug":"reverse-linked-list","has_notes":false,"flag_type":1,"frontend_id":78},{"id":1887607241,"question_id":35,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768643674,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1887607241/","is_pending":"Not Pending","title":"Search Insert Position","memory":"44.7 MB","code":"class Solution {\\n    public int searchInsert(int[] nums, int target) {\\n        int left = 0, right = nums.length - 1;\\n\\n        while (left <= right) {\\n            int mid = left + (right - left) / 2;\\n\\n            if (nums[mid] == target) {\\n                return mid;\\n            } else if (nums[mid] < target) {\\n                left = mid + 1;\\n            } else {\\n                right = mid - 1;\\n            }\\n        }\\n\\n        return left; // insertion position\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111","title_slug":"search-insert-position","has_notes":false,"flag_type":1,"frontend_id":77},{"id":1887606977,"question_id":35,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768643653,"status":20,"status_display":"Compile Error","runtime":"N/A","url":"/submissions/detail/1887606977/","is_pending":"Not Pending","title":"Search Insert Position","memory":"N/A","code":"class Solution {\\n    public int searchInsert(int[] nums, int target) {\\n        int left = 0, right = nums.length - 1;\\n\\n        while (left <= right) {\\n            int mid = left + (right - left) / 2;\\n\\n            if (nums[mid] == target) {\\n                return mid;\\n            } else if (nums[mid] < target) {\\n                left = mid + 1;\\n            } else {\\n                right = mid - 1;\\n            }\\n        }\\n\\n        return left;\\n}\\n","compare_result":null,"title_slug":"search-insert-position","has_notes":false,"flag_type":1,"frontend_id":76},{"id":1887606391,"question_id":169,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768643608,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1887606391/","is_pending":"Not Pending","title":"Majority Element","memory":"56 MB","code":"class Solution {\\n    public int majorityElement(int[] nums) {\\n        int candidate = 0;\\n        int count = 0;\\n\\n        for (int num : nums) {\\n            if (count == 0) {\\n                candidate = num;\\n            }\\n\\n            count += (num == candidate) ? 1 : -1;\\n        }\\n\\n        return candidate;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111","title_slug":"majority-element","has_notes":false,"flag_type":1,"frontend_id":75}],"has_next":true,"last_key":""}'
