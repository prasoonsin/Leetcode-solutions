oid backtrack(int[] nums, int start, List<List<Integer>> ans) {\\n        if (start == nums.length) {\\n            List<Integer> permutation = new ArrayList<>();\\n             for (int x : nums) permutation.add(x);\\n            ans.add(permutation);\\n            return;\\n\\n    }\\n    for (int i = start; i<nums.length; i++) {\\n        swap(nums, start, i);\\n        backtrack(nums, start + 1, ans);\\n        swap(nums, start, i);\\n\\n    }\\n    }\\n    private void swap (int[] nums, int i, int j) {\\n        int temp = nums[i];\\n        nums[i] = nums[j];\\n        nums[j] = temp;\\n    }\\n}","compare_result":"11111111111111111111111111","title_slug":"permutations","has_notes":false,"flag_type":1,"frontend_id":33},{"id":1853080771,"question_id":15,"lang":"cpp","lang_name":"C++","time":"7\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1765471535,"status":10,"status_display":"Accepted","runtime":"55 ms","url":"/submissions/detail/1853080771/","is_pending":"Not Pending","title":"3Sum","memory":"29.1 MB","code":"class Solution {\\npublic:\\n    vector<vector<int>> threeSum(vector<int>& nums) {\\n        vector<vector<int>> res;\\n        sort(nums.begin(), nums.end());\\n        int n = nums.size();\\n        \\n        for (int i = 0; i < n - 2; i++) {\\n            if (i > 0 && nums[i] == nums[i - 1]) continue; // skip duplicates\\n            \\n            int left = i + 1;\\n            int right = n - 1;\\n            \\n            while (left < right) {\\n                int sum = nums[i] + nums[left] + nums[right];\\n                \\n                if (sum == 0) {\\n                    res.push_back({nums[i], nums[left], nums[right]});\\n                    \\n                    // skip duplicates on both sides\\n                    while (left < right && nums[left] == nums[left + 1]) left++;\\n                    while (left < right && nums[right] == nums[right - 1]) right--;\\n                    \\n                    left++;\\n                    right--;\\n                }\\n                else if (sum < 0) {\\n                    left++;\\n                }\\n                else {\\n                    right--;\\n                }\\n            }\\n        }\\n        \\n        return res;\\n    }\\n};","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":32},{"id":1853078167,"question_id":15,"lang":"cpp","lang_name":"C++","time":"7\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1765471357,"status":20,"status_display":"Compile Error","runtime":"N/A","url":"/submissions/detail/1853078167/","is_pending":"Not Pending","title":"3Sum","memory":"N/A","code":"class Solution {\\n    public List<List<Integer>> threeSum(int[] nums) {\\n        List<List<Integer>> res = new ArrayList<>();\\n        Arrays.sort(nums);\\n\\n        int n = nums.length;\\n\\n        for (int i = 0; i < n - 2; i++) {\\n            if (i > 0 && nums[i] == nums[i - 1]) continue;\\n\\n            int left = i + 1;\\n            int right = n - 1;\\n\\n            while (left < right) {\\n                int sum = nums[i] + nums[left] + nums[right];\\n\\n                if (sum == 0) {\\n                    res.add(Arrays.asList(nums[i], nums[left], nums[right]));\\n\\n                    while (left < right && nums[left] == nums[left + 1]) left++;\\n                    while (left < right && nums[right] == nums[right - 1]) right--;\\n\\n                    left++;\\n                    right--;\\n                } else if (sum < 0) {\\n                    left++;\\n                } else {\\n                    right--;\\n                }\\n            }\\n        }\\n\\n        return res;\\n    }\\n}","compare_result":null,"title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":31},{"id":1853077221,"question_id":15,"lang":"cpp","lang_name":"C++","time":"7\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1765471291,"status":20,"status_display":"Compile Error","runtime":"N/A","url":"/submissions/detail/1853077221/","is_pending":"Not Pending","title":"3Sum","memory":"N/A","code":"import java.util.*;\\n\\npublic class Solution {\\n    // Returns list of unique triplets [a,b,c] such that a + b + c == 0\\n    public List<List<Integer>> threeSum(int[] nums) {\\n        List<List<Integer>> res = new ArrayList<>();\\n        if (nums == null || nums.length < 3) return res;\\n\\n        Arrays.sort(nums);                       // sort first\\n        int n = nums.length;\\n\\n        for (int i = 0; i < n - 2; i++) {\\n            // skip duplicates for the first element\\n            if (i > 0 && nums[i] == nums[i - 1]) continue;\\n\\n            int left = i + 1;\\n            int right = n - 1;\\n            int target = -nums[i];\\n\\n            while (left < right) {\\n                int sum = nums[left] + nums[right];\\n                if (sum == target) {\\n                    res.add(Arrays.asList(nums[i], nums[left], nums[right]));\\n\\n                    // move left and right while skipping duplicates\\n                    while (left < right && nums[left] == nums[left + 1]) left++;\\n                    while (left < right && nums[right] == nums[right - 1]) right--;\\n\\n                    left++;\\n                    right--;\\n                } else if (sum < target) {\\n                    left++;\\n                } else { // sum > target\\n                    right--;\\n                }\\n            }\\n        }\\n\\n        return res;\\n    }\\n\\n    // simple tester\\n    public static void main(String[] args) {\\n        Solution s = new Solution();\\n\\n        int[] a1 = {-1,0,1,2,-1,-4};\\n        System.out.println(s.threeSum(a1)); // expected [[-1, -1, 2], [-1, 0, 1]]\\n\\n        int[] a2 = {0,1,1};\\n        System.out.println(s.threeSum(a2)); // expected []\\n\\n        int[] a3 = {0,0,0};\\n        System.out.println(s.threeSum(a3)); // expected [[0,0,0]]\\n    }\\n}","compare_result":null,"title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":30},{"id":1852267379,"question_id":51,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1765389439,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/1852267379/","is_pending":"Not Pending","title":"N-Queens","memory":"46.6 MB","code":"class Solution {\\n\\n    boolean check(int row, int col, int n,List<StringBuilder> board){\\n        int r = row;\\n        int c = col;\\n\\n        // lets check for column\\n\\n        while(r>=0){\\n            if(board.get(r).charAt(c)==\'Q\') return false;\\n            r--;\\n        }\\n\\n        /// lEFT Diagonal:\\n        r = row;\\n        c = col;\\n\\n        while(r>=0 && c>=0){\\n            if(board.get(r).charAt(c)==\'Q\') return false;\\n            r--;\\n            c--;\\n        }\\n\\n        r=row;\\n        c=col;\\n\\n        while(r>=0 && c<n){\\n            if(board.get(r).charAt(c)==\'Q\') return false;\\n            r--;\\n            c++;\\n        }\\n\\n        return true;\\n    }\\n    void solve(List<List<String>> ans,List<StringBuilder> board, int row, int col, int n){\\n\\n        if(row>=n){\\n            List<String> curr = new ArrayList<>();\\n            for(int i=0;i<n;i++){\\n\\n                curr.add(board.get(i).toString());\\n            }\\n            ans.add(curr);\\n            return;\\n\\n        }\\n\\n        for(int i=0;i<n;i++){\\n            if(check(row,i,n,board)){\\n                board.get(row).setCharAt(i,\'Q\');\\n                solve(ans,board,row+1,0,n);\\n                board.get(row).setCharAt(i,\'.\');\\n            }\\n        }\\n    }\\n    public List<List<String>> solveNQueens(int n) {\\n\\n      List<StringBuilder> board = new ArrayList<>();\\n      List<List<String>> ans = new ArrayList<>();\\n      for(int i=0;i<n;i++){\\n        StringBuilder sb = new StringBuilder();\\n        for(int j=0;j<n;j++){\\n            sb.append(\\".\\");\\n        }\\n        board.add(sb);\\n      }  \\n      solve(ans,board,0,0,n);\\n    return ans;  \\n\\n    }\\n    \\n    \\n\\n    \\n}","compare_result":"111111111","title_slug":"n-queens","has_notes":false,"flag_type":1,"frontend_id":29},{"id":1852135685,"question_id":78,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1765380909,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1852135685/","is_pending":"Not Pending","title":"Subsets","memory":"44.2 MB","code":"class Solution {\\n    void solve(List<List<Integer>>ans,List<Integer> curr,int i, int[] nums) {\\n        if(i>=nums.length) {\\n            ArrayList<Integer> temp = new ArrayList<>();\\n            for (int j=0; j<curr.size(); j++)\\n            temp.add(curr.get(j));\\n            ans.add(temp);\\n            return;\\n        }\\n        curr.add(nums[i]);\\n        solve(ans,curr,i+1,nums);\\n        curr.remove(curr.size()-1);\\n        solve(ans,curr,i+1,nums);\\n    }\\n    public List<List<Integer>> subsets(int[] nums) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n        List<Integer> curr = new ArrayList<>();\\n        solve(ans,curr,0,nums);\\n        return ans;\\n    }\\n\\n}","compare_result":"1111111111","title_slug":"subsets","has_notes":false,"flag_type":1,"frontend_id":28},{"id":1851264202,"question_id":11,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months","timestamp":1765297620,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1851264202/","is_pending":"Not Pending","title":"Container With Most Water","memory":"77.4 MB","code":"class Solution {\\n    public int maxArea(int[] height) {\\n        int left = 0;\\n        int right = height.length - 1;\\n        int maxArea = 0;\\n\\n        while (left < right) {\\n            int currentHeight = Math.min(height[left], height[right]);\\n            int width = right - left;\\n            int area = currentHeight * width;\\n\\n            maxArea = Math.max(maxArea, area);\\n\\n            if (height[left] < height[right]) {\\n                left++;\\n            } else {\\n                right--;\\n            }\\n        }\\n\\n        return maxArea;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"container-with-most-water","has_notes":false,"flag_type":1,"frontend_id":27},{"id":1849465129,"question_id":542,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months","timestamp":1765126930,"status":10,"status_display":"Accepted","runtime":"17 ms","url":"/submissions/detail/1849465129/","is_pending":"Not Pending","title":"01 Matrix","memory":"49.1 MB","code":"class Solution {\\n    public int[][] updateMatrix(int[][] mat) {\\n        int m = mat.length;\\n        int n = mat[0].length;\\n\\n        int[][] dist = new int[m][n];\\n        Queue<int[]> q = new ArrayDeque<>();\\n\\n        for (int i = 0; i<m; i++) {\\n            for (int j = 0; j < n; j++) {\\n                if (mat[i][j] == 0) {\\n                    dist[i][j] = 0;\\n                    q.offer(new int[]{i, j});\\n\\n                } else {\\n                    dist[i][j] = -1;\\n                    \\n                }\\n            }\\n        }\\n        int[][] dirs = {{1,0},{-1,0},{0,1},{0,-1}};\\n\\n        while (!q.isEmpty()) {\\n            int[] cell = q.poll();\\n            int r = cell[0];\\n            int c = cell[1];\\n\\n            for (int[] d : dirs) {\\n                int nr = r + d[0];\\n                int nc = c + d[1];\\n\\n                if (nr >= 0 && nr < m && nc >= 0 && nc <n && dist[nr][nc] == -1) {\\n                    dist[nr][nc] = dist[r][c] +1;\\n                    q.offer(new int[]{nr, nc});\\n                }\\n            }\\n        }\\n        return dist;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111","title_slug":"01-matrix","has_notes":null,"flag_type":1,"frontend_id":26},{"id":1847770137,"question_id":1117,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months","timestamp":1764953415,"status":10,"status_display":"Accepted","runtime":"13 ms","url":"/submissions/detail/1847770137/","is_pending":"Not Pending","title":"As Far from Land as Possible","memory":"47.6 MB","code":"class Solution {\\n    public int maxDistance(int[][] grid) {\\n        int n = grid.length;\\n        Queue<int[]> q = new ArrayDeque<>();\\n        int land = 0, water = 0;\\n\\n        for (int i = 0; i<n; i++) {\\n            for (int j = 0; j<n; j++) {\\n                if (grid[i][j] == 1) {\\n                    q.offer(new int[]{i, j});\\n                    land++;\\n                } else {\\n                    water++;\\n                }\\n            }\\n        }\\n        if (land == 0 || water == 0) return -1;\\n\\n        int distance = -1;\\n        int[][] dirs = {{1,0},{-1,0},{0,1},{0,-1}};\\n\\n        while (!q.isEmpty()) {\\n            int size = q.size();\\n            distance++;\\n\\n            for (int s = 0; s < size; s++) {\\n                int[] curr = q.poll();\\n                int r = curr[0], c = curr[1];\\n\\n                for (int[] d : dirs) {\\n                    int nr = r + d[0];\\n                    int nc = c + d[1];\\n\\n                    if (nr >= 0 && nr < n && nc >= 0 && nc < n && grid[nr][nc] == 0) {\\n                        grid[nr][nc] = 2;\\n                        q.offer(new int[]{nr, nc});\\n                        \\n                    }\\n                }\\n            }\\n        }\\n        return distance;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111","title_slug":"as-far-from-land-as-possible","has_notes":false,"flag_type":1,"frontend_id":25},{"id":1846995840,"question_id":1036,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months","timestamp":1764869990,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1846995840/","is_pending":"Not Pending","title":"Rotting Oranges","memory":"44.2 MB","code":"class Solution {\\n    public int orangesRotting(int[][] grid) {\\n        int m = grid.length, n = grid[0].length;\\n        Queue<int[]> q = new java.util.LinkedList<>();\\n        int fresh = 0;\\n\\n      \\n        for (int i = 0; i < m; i++) {\\n            for (int j = 0; j < n; j++) {\\n                if (grid[i][j] == 2) q.offer(new int[]{i, j});\\n                if (grid[i][j] == 1) fresh++;\\n            }\\n        }\\n\\n        if (fresh == 0) return 0; \\n        \\n        int minutes = 0;\\n        int[][] dirs = {{1,0}, {-1,0}, {0,1}, {0,-1}};\\n\\n      \\n        while (!q.isEmpty() && fresh > 0) {\\n            int size = q.size();\\n            \\n            for (int i = 0; i < size; i++) {\\n                int[] cur = q.poll();\\n                int x = cur[0], y = cur[1];\\n\\n                for (int[] d : dirs) {\\n                    int nx = x + d[0], ny = y + d[1];\\n\\n                    if (nx >= 0 && nx < m && ny >= 0 && ny < n && grid[nx][ny] == 1) {\\n                        grid[nx][ny] = 2; // rot it\\n                        fresh--;\\n                        q.offer(new int[]{nx, ny});\\n                    }\\n                }\\n            }\\n            minutes++;\\n        }\\n\\n        return fresh == 0 ? minutes : -1;\\n    }\\n}\\n","compare_result":"","title_slug":"rotting-oranges","has_notes":false,"flag_type":1,"frontend_id":24},{"id":1845949132,"question_id":200,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months","timestamp":1764770278,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1845949132/","is_pending":"Not Pending","title":"Number of Islands","memory":"52.2 MB","code":"class Solution {\\n    public int numIslands(char[][] grid) {\\n        int m = grid.length, n= grid[0].length;\\n        int count = 0;\\n        for (int i = 0; i< m; i++) {\\n            for (int j =0; j<n; j++){\\n                if (grid[i][j] ==\'1\') {\\n                    count++;\\n                    dfs(grid, i, j);\\n                }\\n            }\\n        }\\n        return count;\\n    }\\n    void dfs(char[][] grid, int i, int j){\\n        int m = grid.length, n = grid[0].length;\\n\\n        if (i < 0 || j < 0 || i >= m || j >= n || grid[i][j] == \'0\') return;\\n        grid[i][j] = \'0\';\\n\\n        dfs(grid, i + 1, j);\\n        dfs(grid, i - 1, j);\\n        dfs(grid, i, j + 1);\\n        dfs(grid, i, j - 1);\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"number-of-islands","has_notes":false,"flag_type":1,"frontend_id":23},{"id":1845153233,"question_id":144,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764690695,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1845153233/","is_pending":"Not Pending","title":"Binary Tree Preorder Traversal","memory":"43.1 MB","code":"class Solution {\\n    public List<Integer> preorderTraversal(TreeNode root){\\n        List<Integer> ans = new ArrayList<>();\\n        if (root == null) return ans;\\n\\n        Stack<TreeNode> st = new Stack<>();\\n        st.push(root);\\n\\n        while(!st.isEmpty()) {\\n            TreeNode node = st.pop();\\n            ans.add(node.val);\\n\\n            if (node.right != null) st.push(node.right);\\n            if (node.left != null) st.push(node.left);\\n                  }\\n                  return ans;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-preorder-traversal","has_notes":false,"flag_type":1,"frontend_id":22},{"id":1844352543,"question_id":3,"lang":"cpp","lang_name":"C++","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764610158,"status":10,"status_display":"Accepted","runtime":"16 ms","url":"/submissions/detail/1844352543/","is_pending":"Not Pending","title":"Longest Substring Without Repeating Characters","memory":"14.2 MB","code":"class Solution {\\npublic:\\n    int lengthOfLongestSubstring(string s) {\\n        unordered_set<char> set;\\n        int left = 0, maxLen = 0;\\n\\n        for (int right = 0; right < s.length(); right++) {\\n            while (set.count(s[right])) {\\n                set.erase(s[left]);\\n                left++;\\n            }\\n\\n            set.insert(s[right]);\\n            maxLen = max(maxLen, right - left + 1);\\n        }\\n\\n        return maxLen;\\n    }\\n};\\n","compare_result":"","title_slug":"longest-substring-without-repeating-characters","has_notes":false,"flag_type":1,"frontend_id":21},{"id":1843484914,"question_id":101,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764519747,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1843484914/","is_pending":"Not Pending","title":"Symmetric Tree","memory":"43.5 MB","code":"class Solution {\\n    public boolean isSymmetric(TreeNode root) {\\n        if (root == null) return true;\\n        return isMirror(root.left, root.right);\\n    }\\n\\n    private boolean isMirror(TreeNode t1, TreeNode t2) {\\n        if (t1 == null && t2 == null) return true;\\n        if (t1 == null || t2 == null) return false;\\n        if (t1.val != t2.val) return false;\\n\\n        return isMirror(t1.left, t2.right) &&\\n               isMirror(t1.right, t2.left);\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"symmetric-tree","has_notes":false,"flag_type":1,"frontend_id":20},{"id":1843483731,"question_id":101,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764519639,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1843483731/","is_pending":"Not Pending","title":"Symmetric Tree","memory":"N/A","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    public boolean isSymmetric(TreeNode root) {\\n        if (root == null) return true;\\n        return isMirror(root.left, root.right);\\n        \\n    }\\n    private boolean isMirror(TreeNode t1, TreeNode t2){\\n        if ( t1 == null && t2 == null) return true;\\n\\n        if (t1 == null || t2 == null) return false;\\n\\n        return isMirror(t1.left, t2.right) &&\\n        isMirror(t1.right, t2.left);\\n    }\\n}","compare_result":"11111110111111111101111111111001110111011011100110001101111001011011111110111111111101110111111101110111111110111101111101111111101111111111111101111101110110111111101111111111111111111111111111111111","title_slug":"symmetric-tree","has_notes":false,"flag_type":1,"frontend_id":19},{"id":1841798116,"question_id":817,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764338903,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1841798116/","is_pending":"Not Pending","title":"Design HashMap","memory":"48 MB","code":"class MyHashMap {\\n\\n  \\n    class Node {\\n        int key, value;\\n        Node next;\\n\\n        Node(int key, int value) {\\n            this.key = key;\\n            this.value = value;\\n        }\\n    }\\n\\n    private Node[] buckets;\\n    private final int SIZE = 1000;\\n\\n    public MyHashMap() {\\n        buckets = new Node[SIZE];\\n    }\\n\\n    private int hash(int key) {\\n        return key % SIZE;\\n    }\\n    \\n    public void put(int key, int value) {\\n        int index = hash(key);\\n\\n        \\n        if (buckets[index] == null) {\\n            buckets[index] = new Node(key, value);\\n            return;\\n        }\\n\\n        Node curr = buckets[index];\\n\\n\\n        while (curr != null) {\\n            if (curr.key == key) {\\n                curr.value = value;  \\n                return;\\n            }\\n            if (curr.next == null) break;  \\n            curr = curr.next;\\n        }\\n\\n        curr.next = new Node(key, value);\\n    }\\n    \\n    public int get(int key) {\\n        int index = hash(key);\\n        Node curr = buckets[index];\\n\\n        while (curr != null) {\\n            if (curr.key == key)\\n                return curr.value;\\n            curr = curr.next;\\n        }\\n\\n        return -1;\\n    }\\n    \\n    public void remove(int key) {\\n        int index = hash(key);\\n        Node curr = buckets[index];\\n\\n        if (curr == null) return;\\n\\n        if (curr.key == key) {\\n            buckets[index] = curr.next;\\n            return;\\n        }\\n\\n        Node prev = null;\\n\\n        while (curr != null) {\\n            if (curr.key == key) {\\n                prev.next = curr.next; \\n                return;\\n            }\\n            prev = curr;\\n            curr = curr.next;\\n        }\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111","title_slug":"design-hashmap","has_notes":false,"flag_type":1,"frontend_id":18},{"id":1841791718,"question_id":102,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764338241,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1841791718/","is_pending":"Not Pending","title":"Binary Tree Level Order Traversal","memory":"46 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    public List<List<Integer>> levelOrder(TreeNode root) {\\n        List<List<Integer>> result = new ArrayList<>();\\n\\n        if (root == null)\\n        return result;\\n\\n         Queue<TreeNode> q = new  LinkedList<>();\\n        q.add(root);\\n\\n        while(!q.isEmpty()) {\\n\\n            int size = q.size();\\n            List<Integer> level = new ArrayList<>();\\n\\n            for (int i = 0; i<size; i++) {\\n\\n                TreeNode curr = q.poll();\\n                level.add(curr.val);\\n\\n                if(curr.left != null)\\n                q.add(curr.left);\\n\\n                if (curr.right != null)\\n                q.add(curr.right);\\n\\n            }\\n            result.add(level);\\n\\n        }      \\n        return result;  \\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"binary-tree-level-order-traversal","has_notes":false,"flag_type":1,"frontend_id":17},{"id":1841784067,"question_id":100,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 1\xc2\xa0week","timestamp":1764337444,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1841784067/","is_pending":"Not Pending","title":"Same Tree","memory":"42.8 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n   boolean checkSameTree(TreeNode p, TreeNode q) {\\n        if (p == null && q == null)\\n        return true;\\n\\n        if (p == null || q == null)\\n        return false;\\n\\n        if ( p.val != q.val)\\n        return false;\\n\\n        boolean left = checkSameTree(p.left, q.left);\\n        boolean right = checkSameTree(p.right, q.right);\\n\\n        return left && right;\\n    }\\n    public boolean isSameTree(TreeNode p, TreeNode q) {\\n        return checkSameTree(p, q);\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111","title_slug":"same-tree","has_notes":false,"flag_type":1,"frontend_id":16},{"id":1835040288,"question_id":1127,"lang":"java","lang_name":"Java","time":"8\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1763633586,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1835040288/","is_pending":"Not Pending","title":"Last Stone Weight","memory":"42.8 MB","code":"class Solution {\\n    public int lastStoneWeight(int[] stones) {\\n        int n = stones.length;\\n        PriorityQueue<Integer> pq = new PriorityQueue<>(Collections.reverseOrder());\\n\\n        for(int i = 0 ; i < n; i++){\\n            pq.add(stones[i]);\\n        }\\n\\n        while(pq.size() > 1){\\n            int heaviest = pq.remove();\\n            int secondHeaviest = pq.remove();\\n\\n            int remaining = heaviest - secondHeaviest;\\n            pq.add(remaining);\\n        }\\n        return pq.peek();\\n    }\\n        }","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"last-stone-weight","has_notes":false,"flag_type":1,"frontend_id":15}],"has_next":true,"last_key":""}'
