    StringBuilder result = new StringBuilder();\\n        for (StringBuilder row : rows) {\\n            result.append(row);\\n        }\\n\\n        return result.toString();\\n    }\\n}","compare_result":"","title_slug":"zigzag-conversion","has_notes":false,"flag_type":1,"frontend_id":43},{"id":1859179449,"question_id":5,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1766081358,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1859179449/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"43.8 MB","code":"class Solution {\\n    public String longestPalindrome(String s) {\\n        if (s == null || s.length() < 1) return \\"\\";\\n\\n        int start = 0, end = 0;\\n\\n        for (int i = 0; i < s.length(); i++) {\\n            int len1 = expandFromCenter(s, i, i);     // odd length\\n            int len2 = expandFromCenter(s, i, i + 1); // even length\\n            int len = Math.max(len1, len2);\\n\\n            if (len > end - start) {\\n                start = i - (len - 1) / 2;\\n                end   = i + len / 2;\\n            }\\n        }\\n        return s.substring(start, end + 1);\\n    }\\n\\n    private int expandFromCenter(String s, int left, int right) {\\n        while (left >= 0 && right < s.length() &&\\n               s.charAt(left) == s.charAt(right)) {\\n            left--;\\n            right++;\\n        }\\n        return right - left - 1;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":42},{"id":1859166491,"question_id":5,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1766080502,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1859166491/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"43.6 MB","code":"class Solution {\\n    public String longestPalindrome(String s) {\\n        if (s == null || s.length() < 1) return \\"\\";\\n\\n        int start = 0, end = 0;\\n\\n        for (int i = 0; i < s.length(); i++) {\\n            int len1 = expandFromCenter(s, i, i);     // odd length\\n            int len2 = expandFromCenter(s, i, i + 1); // even length\\n            int len = Math.max(len1, len2);\\n\\n            if (len > end - start) {\\n                start = i - (len - 1) / 2;\\n                end   = i + len / 2;\\n            }\\n        }\\n        return s.substring(start, end + 1);\\n    }\\n\\n    private int expandFromCenter(String s, int left, int right) {\\n        while (left >= 0 && right < s.length() &&\\n               s.charAt(left) == s.charAt(right)) {\\n            left--;\\n            right++;\\n        }\\n        return right - left - 1;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":41},{"id":1859165677,"question_id":5,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1766080448,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1859165677/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"43.7 MB","code":"class Solution {\\n    public String longestPalindrome(String s) {\\n        if (s == null || s.length() < 1) return \\"\\";\\n\\n        int start = 0, end = 0;\\n\\n        for (int i = 0; i < s.length(); i++) {\\n            int len1 = expandFromCenter(s, i, i);     // odd length\\n            int len2 = expandFromCenter(s, i, i + 1); // even length\\n            int len = Math.max(len1, len2);\\n\\n            if (len > end - start) {\\n                start = i - (len - 1) / 2;\\n                end   = i + len / 2;\\n            }\\n        }\\n        return s.substring(start, end + 1);\\n    }\\n\\n    private int expandFromCenter(String s, int left, int right) {\\n        while (left >= 0 && right < s.length() &&\\n               s.charAt(left) == s.charAt(right)) {\\n            left--;\\n            right++;\\n        }\\n        return right - left - 1;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":40},{"id":1859131441,"question_id":4,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1766078179,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1859131441/","is_pending":"Not Pending","title":"Median of Two Sorted Arrays","memory":"48.8 MB","code":"class Solution {\\n    public double findMedianSortedArrays(int[] nums1, int[] nums2) {\\n        \\n        int m = nums1.length;\\n        int n = nums2.length;\\n\\n        int[] arr = new int[m+n];\\n        int i =0, j = 0, k = 0;\\n\\n        while (i< m && j < n) {\\n            if (nums1[i] < nums2[j]) {\\n                arr[k++] = nums1[i++];\\n            } else {\\n                arr[k++] = nums2[j++];\\n            }\\n        }\\n        while (i < m) arr[k++] = nums1[i++];\\n        while (j < n) arr[k++] = nums2[j++];\\n\\n        int len = m + n;\\n\\n        if (len% 2 == 1) {\\n            return arr[len/2];\\n        } else {\\n            return (arr[len / 2 -1] + arr[len / 2]) / 2.0;\\n        }\\n    }\\n}","compare_result":"","title_slug":"median-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":39},{"id":1858235107,"question_id":79,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1765990791,"status":10,"status_display":"Accepted","runtime":"127 ms","url":"/submissions/detail/1858235107/","is_pending":"Not Pending","title":"Word Search","memory":"42.9 MB","code":"class Solution {\\n    public boolean exist(char[][] board, String word) {\\n        int m = board.length;\\n        int n = board[0].length;\\n\\n        for (int i = 0; i<m; i++){\\n            for (int j = 0; j<n; j++){\\n                if (dfs(board, word, i, j, 0)) {\\n                    return true;\\n                }\\n            }\\n        }\\n        return false;\\n    }\\n    private boolean dfs(char[][] board, String word, int row, int col, int index) {\\n        if (index == word.length()) return true;\\n\\n        if (row <0 || col < 0 || row >= board.length || col >= board[0].length || board[row][col] != word.charAt(index)) {\\n            return false;\\n        }\\n        char temp = board[row][col];\\n        board[row][col] =\'#\';\\n\\n        boolean found =\\n        dfs(board, word, row + 1, col, index + 1) ||\\n        dfs(board, word, row - 1, col, index +1) ||\\n        dfs(board, word, row, col + 1, index + 1) ||\\n        dfs(board, word, row, col - 1, index + 1);\\n\\n        board[row][col] = temp;\\n        return found;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"word-search","has_notes":false,"flag_type":1,"frontend_id":38},{"id":1857303731,"question_id":90,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1765902081,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1857303731/","is_pending":"Not Pending","title":"Subsets II","memory":"45 MB","code":"class Solution {\\n    public List<List<Integer>> subsetsWithDup(int[] nums) {\\n        List<List<Integer>> result = new ArrayList<>();\\n        Arrays.sort(nums);\\n        backtrack(0, nums, new ArrayList<>(), result);\\n        return result;\\n    }\\n    private void backtrack(int index, int[] nums, List<Integer> current, List<List<Integer>> result) {\\n        result.add(new ArrayList<>(current));\\n        for (int i = index; i< nums.length; i++) {\\n            if (i > index && nums[i] == nums[i - 1]) {\\n                continue;\\n            }\\n            current.add(nums[i]);\\n            backtrack(i + 1, nums, current, result);\\n            current.remove(current.size() - 1);\\n        }\\n    }\\n}","compare_result":"11111111111111111111","title_slug":"subsets-ii","has_notes":false,"flag_type":1,"frontend_id":37},{"id":1856383926,"question_id":40,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1765814118,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/1856383926/","is_pending":"Not Pending","title":"Combination Sum II","memory":"45.6 MB","code":"class Solution {\\n    public List<List<Integer>> combinationSum2(int[] candidates, int target) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n\\n        Arrays.sort(candidates);\\n        backtrack(0, candidates, target, new ArrayList<>(), ans);\\n        return ans;\\n    }\\n    private void backtrack(int start, int[] candidates, int target, List<Integer> curr, List<List<Integer>> ans) {\\n        if  ( target == 0) {\\n            ans.add(new ArrayList<>(curr));\\n            return;\\n        }\\n        for (int i = start; i< candidates.length; i++) {\\n            if (i> start && candidates[i] == candidates[i-1]) continue;\\n            if (candidates[i] > target) break;\\n\\n            curr.add(candidates[i]);\\n            backtrack(i + 1, candidates, target - candidates[i],curr, ans);\\n            curr.remove(curr.size() - 1);\\n        }\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"combination-sum-ii","has_notes":false,"flag_type":1,"frontend_id":36},{"id":1856383262,"question_id":40,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1765814078,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/1856383262/","is_pending":"Not Pending","title":"Combination Sum II","memory":"45.3 MB","code":"class Solution {\\n    public List<List<Integer>> combinationSum2(int[] candidates, int target) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n\\n        Arrays.sort(candidates);\\n        backtrack(0, candidates, target, new ArrayList<>(), ans);\\n        return ans;\\n    }\\n    private void backtrack(int start, int[] candidates, int target, List<Integer> curr, List<List<Integer>> ans) {\\n        if  ( target == 0) {\\n            ans.add(new ArrayList<>(curr));\\n            return;\\n        }\\n        for (int i = start; i< candidates.length; i++) {\\n            if (i> start && candidates[i] == candidates[i-1]) continue;\\n            if (candidates[i] > target) break;\\n\\n            curr.add(candidates[i]);\\n            backtrack(i + 1, candidates, target - candidates[i],curr, ans);\\n            curr.remove(curr.size() - 1);\\n        }\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"combination-sum-ii","has_notes":false,"flag_type":1,"frontend_id":35}],"has_next":true,"last_key":""}'
