ava","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780415462,"status":10,"status_display":"Accepted","runtime":"38 ms","url":"/submissions/detail/2020346911/","is_pending":"Not Pending","title":"Longest Increasing Subsequence","memory":"46.1 MB","code":"class Solution {\\n    public int lengthOfLIS(int[] nums) {\\n        int[] dp = new int[nums.length];\\n        Arrays.fill(dp, 1);\\n        int max = 1;\\n\\n        for (int i = 1; i < nums.length; i++)\\n            for (int j = 0; j < i; j++)\\n                if (nums[i] > nums[j])\\n                    dp[i] = Math.max(dp[i], dp[j] + 1);\\n\\n        for (int x : dp) max = Math.max(max, x);\\n        return max;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111","title_slug":"longest-increasing-subsequence","has_notes":false,"flag_type":1,"frontend_id":192},{"id":2019942212,"question_id":547,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780387786,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2019942212/","is_pending":"Not Pending","title":"Number of Provinces","memory":"47 MB","code":"class Solution {\\n    public int findCircleNum(int[][] isConnected) {\\n        int n = isConnected.length;\\n        boolean[] visited = new boolean[n];\\n        int provinces = 0;\\n\\n        for (int i = 0; i < n; i++) {\\n            if (!visited[i]) {\\n                dfs(isConnected, visited, i);\\n                provinces++;\\n            }\\n        }\\n\\n        return provinces;\\n    }\\n\\n    private void dfs(int[][] isConnected, boolean[] visited, int city) {\\n        visited[city] = true;\\n\\n        for (int j = 0; j < isConnected.length; j++) {\\n            if (isConnected[city][j] == 1 && !visited[j]) {\\n                dfs(isConnected, visited, j);\\n            }\\n        }\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"number-of-provinces","has_notes":false,"flag_type":1,"frontend_id":191},{"id":2019934835,"question_id":169,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780387248,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019934835/","is_pending":"Not Pending","title":"Majority Element","memory":"55.6 MB","code":"class Solution {\\n    public int majorityElement(int[] nums) {\\n        int candidate = 0;\\n        int count = 0;\\n\\n        for (int num : nums) {\\n            if (count == 0) {\\n                candidate = num;\\n            }\\n\\n            if (num == candidate) {\\n                count++;\\n            } else {\\n                count--;\\n            }\\n        }\\n\\n        return candidate;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111","title_slug":"majority-element","has_notes":false,"flag_type":1,"frontend_id":190},{"id":2019932669,"question_id":724,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780387092,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2019932669/","is_pending":"Not Pending","title":"Find Pivot Index","memory":"47.4 MB","code":"class Solution {\\n    public int pivotIndex(int[] nums) {\\n        int totalSum = 0;\\n\\n        for (int num : nums) {\\n            totalSum += num;\\n        }\\n\\n        int leftSum = 0;\\n\\n        for (int i = 0; i < nums.length; i++) {\\n            totalSum -= nums[i];\\n\\n            if (leftSum == totalSum) {\\n                return i;\\n            }\\n\\n            leftSum += nums[i];\\n        }\\n\\n        return -1;\\n    }\\n}","compare_result":"","title_slug":"find-pivot-index","has_notes":false,"flag_type":1,"frontend_id":189},{"id":2019931312,"question_id":1603,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780386993,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019931312/","is_pending":"Not Pending","title":"Running Sum of 1d Array","memory":"44.3 MB","code":"class Solution {\\n    public int[] runningSum(int[] nums) {\\n        int[] prefix = new int[nums.length];\\n\\n        prefix[0] = nums[0];\\n\\n        for (int i = 1; i < nums.length; i++) {\\n            prefix[i] = prefix[i - 1] + nums[i];\\n        }\\n\\n        return prefix;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"running-sum-of-1d-array","has_notes":false,"flag_type":1,"frontend_id":188},{"id":2019857905,"question_id":1669,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780382338,"status":10,"status_display":"Accepted","runtime":"15 ms","url":"/submissions/detail/2019857905/","is_pending":"Not Pending","title":"Minimum Cost to Cut a Stick","memory":"44.7 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public int minCost(int n, int[] cuts) {\\n\\n        int m = cuts.length;\\n\\n        int[] arr = new int[m + 2];\\n        arr[0] = 0;\\n        arr[m + 1] = n;\\n\\n        for (int i = 0; i < m; i++) {\\n            arr[i + 1] = cuts[i];\\n        }\\n\\n        Arrays.sort(arr);\\n\\n        int[][] dp = new int[m + 2][m + 2];\\n\\n        for (int len = 2; len < m + 2; len++) {\\n\\n            for (int i = 0; i + len < m + 2; i++) {\\n\\n                int j = i + len;\\n                dp[i][j] = Integer.MAX_VALUE;\\n\\n                for (int k = i + 1; k < j; k++) {\\n\\n                    dp[i][j] = Math.min(\\n                        dp[i][j],\\n                        dp[i][k] + dp[k][j] + (arr[j] - arr[i])\\n                    );\\n                }\\n\\n                if (dp[i][j] == Integer.MAX_VALUE) {\\n                    dp[i][j] = 0;\\n                }\\n            }\\n        }\\n\\n        return dp[0][m + 1];\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-cost-to-cut-a-stick","has_notes":false,"flag_type":1,"frontend_id":187},{"id":2019852604,"question_id":803,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780382052,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2019852604/","is_pending":"Not Pending","title":"Cheapest Flights Within K Stops","memory":"46.3 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public int findCheapestPrice(int n, int[][] flights, int src, int dst, int k) {\\n\\n        List<List<int[]>> graph = new ArrayList<>();\\n\\n        for (int i = 0; i < n; i++) {\\n            graph.add(new ArrayList<>());\\n        }\\n\\n        for (int[] flight : flights) {\\n            graph.get(flight[0]).add(new int[]{flight[1], flight[2]});\\n        }\\n\\n        int[] cost = new int[n];\\n        Arrays.fill(cost, Integer.MAX_VALUE);\\n        cost[src] = 0;\\n\\n        Queue<int[]> queue = new LinkedList<>();\\n        queue.offer(new int[]{src, 0});\\n\\n        int stops = 0;\\n\\n        while (!queue.isEmpty() && stops <= k) {\\n\\n            int size = queue.size();\\n            int[] tempCost = cost.clone();\\n\\n            for (int i = 0; i < size; i++) {\\n\\n                int[] current = queue.poll();\\n                int city = current[0];\\n                int currentCost = current[1];\\n\\n                for (int[] neighbor : graph.get(city)) {\\n\\n                    int nextCity = neighbor[0];\\n                    int price = neighbor[1];\\n\\n                    if (currentCost + price < tempCost[nextCity]) {\\n                        tempCost[nextCity] = currentCost + price;\\n                        queue.offer(new int[]{nextCity, tempCost[nextCity]});\\n                    }\\n                }\\n            }\\n\\n            cost = tempCost;\\n            stops++;\\n        }\\n\\n        return cost[dst] == Integer.MAX_VALUE ? -1 : cost[dst];\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111","title_slug":"cheapest-flights-within-k-stops","has_notes":false,"flag_type":1,"frontend_id":186},{"id":2019851698,"question_id":803,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780382003,"status":20,"status_display":"Compile Error","runtime":"N/A","url":"/submissions/detail/2019851698/","is_pending":"Not Pending","title":"Cheapest Flights Within K Stops","memory":"N/A","code":"import java.util.*;\\n\\nclass Solution {\\n    public int findCheapestPrice(int n, int[][] flights, int src, int dst, int k) {\\n\\n        List<List<int[]>> graph = new ArrayList<>();\\n\\n        for (int i = 0; i < n; i++) {\\n            graph.add(new ArrayList<>());\\n        }\\n\\n        for (int[] flight : flights) {\\n            graph.get(flight[0]).add(new int[]{flight[1], flight[2]});\\n        }\\n\\n        int[] cost = new int[n];\\n        Arrays.fill(cost, Integer.MAX_VALUE);\\n        cost[src] = 0;\\n\\n        Queue<int[]> queue = new LinkedList<>();\\n        queue.offer(new int[]{src, 0});\\n\\n        int stops = 0;\\n\\n        while (!queue.isEmpty() && stops <= k) {\\n\\n            int size = queue.size();\\n            int[] tempCost = cost.clone();\\n\\n            for (int i = 0; i < size; i++) {\\n\\n                int[] current = queue.poll();\\n                int city = current[0];\\n                int currentCost = current[1];\\n\\n                for (int[] neighbor : graph.get(city)) {\\n\\n                    int nextCity = neighbor[0];\\n                    int price = neighbor[1];\\n\\n                    if (currentCost + price < tempCost[nextCity]) {\\n                        tempCost[nextCity] = currentCost + price;\\n                        queue.offer(new int[]{nextCity, tempCost[nextCity]});\\n                    }\\n                }\\n            }\\n\\n            cost = tempCost;\\n            stops++;\\n        }\\n\\n        return cost[dst] == Integer.MAX_VALUE ? -1 : cost[dst];\\n    }\\n}Stops\\n\\n","compare_result":null,"title_slug":"cheapest-flights-within-k-stops","has_notes":false,"flag_type":1,"frontend_id":185},{"id":2019849998,"question_id":733,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381913,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019849998/","is_pending":"Not Pending","title":"Flood Fill","memory":"46.9 MB","code":"class Solution {\\n\\n    public int[][] floodFill(int[][] image, int sr, int sc, int color) {\\n        int originalColor = image[sr][sc];\\n\\n        if (originalColor == color) {\\n            return image;\\n        }\\n\\n        dfs(image, sr, sc, originalColor, color);\\n        return image;\\n    }\\n\\n    private void dfs(int[][] image, int row, int col, int originalColor, int color) {\\n\\n        if (row < 0 || row >= image.length ||\\n            col < 0 || col >= image[0].length ||\\n            image[row][col] != originalColor) {\\n            return;\\n        }\\n\\n        image[row][col] = color;\\n\\n        dfs(image, row + 1, col, originalColor, color);\\n        dfs(image, row - 1, col, originalColor, color);\\n        dfs(image, row, col + 1, originalColor, color);\\n        dfs(image, row, col - 1, originalColor, color);\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"flood-fill","has_notes":false,"flag_type":1,"frontend_id":184},{"id":2019848314,"question_id":102,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381821,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2019848314/","is_pending":"Not Pending","title":"Binary Tree Level Order Traversal","memory":"46.7 MB","code":"/**\\n * Definition for a binary tree node.\\n * public class TreeNode {\\n *     int val;\\n *     TreeNode left;\\n *     TreeNode right;\\n *     TreeNode() {}\\n *     TreeNode(int val) { this.val = val; }\\n *     TreeNode(int val, TreeNode left, TreeNode right) {\\n *         this.val = val;\\n *         this.left = left;\\n *         this.right = right;\\n *     }\\n * }\\n */\\nclass Solution {\\n    public List<List<Integer>> levelOrder(TreeNode root) {\\n        List<List<Integer>> result = new ArrayList<>();\\n\\n        if (root == null)\\n        return result;\\n\\n         Queue<TreeNode> q = new  LinkedList<>();\\n        q.add(root);\\n\\n        while(!q.isEmpty()) {\\n\\n            int size = q.size();\\n            List<Integer> level = new ArrayList<>();\\n\\n            for (int i = 0; i<size; i++) {\\n\\n                TreeNode curr = q.poll();\\n                level.add(curr.val);\\n\\n                if(curr.left != null)\\n                q.add(curr.left);\\n\\n                if (curr.right != null)\\n                q.add(curr.right);\\n\\n            }\\n            result.add(level);\\n\\n        }      \\n        return result;  \\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"binary-tree-level-order-traversal","has_notes":false,"flag_type":1,"frontend_id":183},{"id":2019847403,"question_id":560,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381774,"status":10,"status_display":"Accepted","runtime":"25 ms","url":"/submissions/detail/2019847403/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"48.6 MB","code":"class Solution {\\n    public int subarraySum(int[] nums, int k) {\\n        Map<Integer, Integer> map = new HashMap<>();\\n        map.put(0, 1);\\n\\n        int sum = 0, count = 0;\\n        for (int n : nums) {\\n            sum += n;\\n            count += map.getOrDefault(sum - k, 0);\\n            map.put(sum, map.getOrDefault(sum, 0) + 1);\\n        }\\n        return count;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":182},{"id":2019846739,"question_id":4,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381738,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019846739/","is_pending":"Not Pending","title":"Median of Two Sorted Arrays","memory":"48.8 MB","code":"class Solution {\\n    public double findMedianSortedArrays(int[] nums1, int[] nums2) {\\n        \\n        int m = nums1.length;\\n        int n = nums2.length;\\n\\n        int[] arr = new int[m+n];\\n        int i =0, j = 0, k = 0;\\n\\n        while (i< m && j < n) {\\n            if (nums1[i] < nums2[j]) {\\n                arr[k++] = nums1[i++];\\n            } else {\\n                arr[k++] = nums2[j++];\\n            }\\n        }\\n        while (i < m) arr[k++] = nums1[i++];\\n        while (j < n) arr[k++] = nums2[j++];\\n\\n        int len = m + n;\\n\\n        if (len% 2 == 1) {\\n            return arr[len/2];\\n        } else {\\n            return (arr[len / 2 -1] + arr[len / 2]) / 2.0;\\n        }\\n    }\\n}\\n","compare_result":"","title_slug":"median-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":181},{"id":2019844934,"question_id":1966,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381640,"status":10,"status_display":"Accepted","runtime":"33 ms","url":"/submissions/detail/2019844934/","is_pending":"Not Pending","title":"Frequency of the Most Frequent Element","memory":"94.8 MB","code":"import java.util.Arrays;\\n\\nclass Solution {\\n    public int maxFrequency(int[] nums, int k) {\\n        Arrays.sort(nums);\\n\\n        long total = 0;\\n        int left = 0;\\n        int result = 1;\\n\\n        for (int right = 0; right < nums.length; right++) {\\n            total += nums[right];\\n\\n            while ((long) nums[right] * (right - left + 1) - total > k) {\\n                total -= nums[left];\\n                left++;\\n            }\\n\\n            result = Math.max(result, right - left + 1);\\n        }\\n\\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"frequency-of-the-most-frequent-element","has_notes":false,"flag_type":1,"frontend_id":180},{"id":2019844151,"question_id":78,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381600,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019844151/","is_pending":"Not Pending","title":"Subsets","memory":"44.2 MB","code":"class Solution {\\n    void solve(List<List<Integer>>ans,List<Integer> curr,int i, int[] nums) {\\n        if(i>=nums.length) {\\n            ArrayList<Integer> temp = new ArrayList<>();\\n            for (int j=0; j<curr.size(); j++)\\n            temp.add(curr.get(j));\\n            ans.add(temp);\\n            return;\\n        }\\n        curr.add(nums[i]);\\n        solve(ans,curr,i+1,nums);\\n        curr.remove(curr.size()-1);\\n        solve(ans,curr,i+1,nums);\\n    }\\n    public List<List<Integer>> subsets(int[] nums) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n        List<Integer> curr = new ArrayList<>();\\n        solve(ans,curr,0,nums);\\n        return ans;\\n    }\\n\\n}","compare_result":"1111111111","title_slug":"subsets","has_notes":false,"flag_type":1,"frontend_id":179},{"id":2019843379,"question_id":39,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381558,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019843379/","is_pending":"Not Pending","title":"Combination Sum","memory":"46 MB","code":"import java.util.*;\\n\\nclass Solution {\\n\\n    public List<List<Integer>> combinationSum(int[] candidates, int target) {\\n        List<List<Integer>> ans = new ArrayList<>();\\n        backtrack(0, candidates, target, new ArrayList<>(), ans);\\n        return ans;\\n    }\\n\\n    private void backtrack(int index, int[] candidates, int target,\\n                           List<Integer> curr, List<List<Integer>> ans) {\\n\\n    \\n        if (target == 0) {\\n            ans.add(new ArrayList<>(curr));\\n            return;\\n        }\\n\\n  \\n        if (target < 0) return;\\n\\n    \\n        for (int i = index; i < candidates.length; i++) {\\n            curr.add(candidates[i]);\\n            backtrack(i, candidates, target - candidates[i], curr, ans); \\n            curr.remove(curr.size() - 1); \\n        }\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"combination-sum","has_notes":false,"flag_type":1,"frontend_id":178},{"id":2019840069,"question_id":1036,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381386,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019840069/","is_pending":"Not Pending","title":"Rotting Oranges","memory":"44 MB","code":"class Solution {\\n    public int orangesRotting(int[][] grid) {\\n        int m = grid.length, n = grid[0].length;\\n        Queue<int[]> q = new java.util.LinkedList<>();\\n        int fresh = 0;\\n\\n      \\n        for (int i = 0; i < m; i++) {\\n            for (int j = 0; j < n; j++) {\\n                if (grid[i][j] == 2) q.offer(new int[]{i, j});\\n                if (grid[i][j] == 1) fresh++;\\n            }\\n        }\\n\\n        if (fresh == 0) return 0; \\n        \\n        int minutes = 0;\\n        int[][] dirs = {{1,0}, {-1,0}, {0,1}, {0,-1}};\\n\\n      \\n        while (!q.isEmpty() && fresh > 0) {\\n            int size = q.size();\\n            \\n            for (int i = 0; i < size; i++) {\\n                int[] cur = q.poll();\\n                int x = cur[0], y = cur[1];\\n\\n                for (int[] d : dirs) {\\n                    int nx = x + d[0], ny = y + d[1];\\n\\n                    if (nx >= 0 && nx < m && ny >= 0 && ny < n && grid[nx][ny] == 1) {\\n                        grid[nx][ny] = 2; // rot it\\n                        fresh--;\\n                        q.offer(new int[]{nx, ny});\\n                    }\\n                }\\n            }\\n            minutes++;\\n        }\\n\\n        return fresh == 0 ? minutes : -1;\\n    }\\n}","compare_result":"","title_slug":"rotting-oranges","has_notes":false,"flag_type":1,"frontend_id":177},{"id":2019837264,"question_id":160,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381239,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2019837264/","is_pending":"Not Pending","title":"Intersection of Two Linked Lists","memory":"52.8 MB","code":"class Solution {\\n    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {\\n        if (headA == null || headB == null) return null;\\n\\n        ListNode a = headA;\\n        ListNode b = headB;\\n\\n        while (a != b) {\\n            a = (a == null) ? headB : a.next;\\n            b = (b == null) ? headA : b.next;\\n        }\\n\\n        return a; // intersection node or null\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111","title_slug":"intersection-of-two-linked-lists","has_notes":false,"flag_type":1,"frontend_id":176},{"id":2019835947,"question_id":21,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1780381167,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2019835947/","is_pending":"Not Pending","title":"Merge Two Sorted Lists","memory":"44.5 MB","code":"class Solution {\\n    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {\\n        ListNode dummy = new ListNode(-1);\\n        ListNode tail = dummy;\\n\\n        while (list1 != null && list2 != null) {\\n            if (list1.val <= list2.val) {\\n                tail.next = list1;\\n                list1 = list1.next;\\n            } else {\\n                tail.next = list2;\\n                list2 = list2.next;\\n            }\\n            tail = tail.next;\\n        }\\n\\n        // attach remaining nodes\\n        tail.next = (list1 != null) ? list1 : list2;\\n\\n        return dummy.next;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-two-sorted-lists","has_notes":false,"flag_type":1,"frontend_id":175}],"has_next":true,"last_key":""}'
