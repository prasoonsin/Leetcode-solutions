n        return maxProfit;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"best-time-to-buy-and-sell-stock","has_notes":false,"flag_type":1,"frontend_id":64},{"id":1876820125,"question_id":213,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months","timestamp":1767723917,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1876820125/","is_pending":"Not Pending","title":"House Robber II","memory":"42.8 MB","code":"class Solution {\\n    public int rob(int[] nums) {\\n        int n = nums.length;\\n        if (n == 1) return nums[0];\\n\\n        // Case 1: rob from 0 to n-2\\n        int money1 = robLinear(nums, 0, n - 2);\\n\\n        // Case 2: rob from 1 to n-1\\n        int money2 = robLinear(nums, 1, n - 1);\\n\\n        return Math.max(money1, money2);\\n    }\\n\\n    private int robLinear(int[] nums, int start, int end) {\\n        int prev2 = 0; // dp[i-2]\\n        int prev1 = 0; // dp[i-1]\\n\\n        for (int i = start; i <= end; i++) {\\n            int take = prev2 + nums[i];\\n            int skip = prev1;\\n            int curr = Math.max(take, skip);\\n\\n            prev2 = prev1;\\n            prev1 = curr;\\n        }\\n        return prev1;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"house-robber-ii","has_notes":false,"flag_type":1,"frontend_id":63},{"id":1876813997,"question_id":213,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months","timestamp":1767723615,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1876813997/","is_pending":"Not Pending","title":"House Robber II","memory":"43 MB","code":"class Solution {\\n    public int rob(int[] nums) {\\n        int n = nums.length;\\n        if (n == 1) return nums[0];\\n\\n        // Case 1: rob from 0 to n-2\\n        int money1 = robLinear(nums, 0, n - 2);\\n\\n        // Case 2: rob from 1 to n-1\\n        int money2 = robLinear(nums, 1, n - 1);\\n\\n        return Math.max(money1, money2);\\n    }\\n\\n    private int robLinear(int[] nums, int start, int end) {\\n        int prev2 = 0; // dp[i-2]\\n        int prev1 = 0; // dp[i-1]\\n\\n        for (int i = start; i <= end; i++) {\\n            int take = prev2 + nums[i];\\n            int skip = prev1;\\n            int curr = Math.max(take, skip);\\n\\n            prev2 = prev1;\\n            prev1 = curr;\\n        }\\n        return prev1;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"house-robber-ii","has_notes":false,"flag_type":1,"frontend_id":62},{"id":1875567593,"question_id":198,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months","timestamp":1767633185,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1875567593/","is_pending":"Not Pending","title":"House Robber","memory":"42.7 MB","code":"class Solution {\\n    public int rob(int[] nums) {\\n        int n = nums.length;\\n        \\n        if (n == 1) return nums[0];\\n\\n        int[] dp = new int[n];\\n\\n        dp[0] = nums[0];\\n        dp[1] = Math.max(nums[0], nums[1]);\\n\\n        for (int i = 2; i < n; i++) {\\n            dp[i] = Math.max(dp[i - 1], dp[i - 2] + nums[i]);\\n        }\\n\\n        return dp[n - 1];\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"house-robber","has_notes":false,"flag_type":1,"frontend_id":61},{"id":1873429492,"question_id":8,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months","timestamp":1767462114,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1873429492/","is_pending":"Not Pending","title":"String to Integer (atoi)","memory":"43.8 MB","code":"class Solution {\\n    public int myAtoi(String s) {\\n        int i = 0, n = s.length();\\n        int sign = 1;\\n        int result = 0;\\n\\n        // 1\xef\xb8\x8f\xe2\x83\xa3 Skip leading spaces\\n        while (i < n && s.charAt(i) == \' \') {\\n            i++;\\n        }\\n\\n        // 2\xef\xb8\x8f\xe2\x83\xa3 Check sign\\n        if (i < n && (s.charAt(i) == \'+\' || s.charAt(i) == \'-\')) {\\n            if (s.charAt(i) == \'-\') sign = -1;\\n            i++;\\n        }\\n\\n        // 3\xef\xb8\x8f\xe2\x83\xa3 Convert digits\\n        while (i < n && Character.isDigit(s.charAt(i))) {\\n            int digit = s.charAt(i) - \'0\';\\n\\n            // 4\xef\xb8\x8f\xe2\x83\xa3 Handle overflow\\n            if (result > Integer.MAX_VALUE / 10 || \\n               (result == Integer.MAX_VALUE / 10 && digit > 7)) {\\n                return sign == 1 ? Integer.MAX_VALUE : Integer.MIN_VALUE;\\n            }\\n\\n            result = result * 10 + digit;\\n            i++;\\n        }\\n\\n        return result * sign;\\n    }\\n}","compare_result":"","title_slug":"string-to-integer-atoi","has_notes":false,"flag_type":1,"frontend_id":60},{"id":1872362407,"question_id":18,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 1\xc2\xa0week","timestamp":1767377245,"status":10,"status_display":"Accepted","runtime":"21 ms","url":"/submissions/detail/1872362407/","is_pending":"Not Pending","title":"4Sum","memory":"45.8 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public List<List<Integer>> fourSum(int[] nums, int target) {\\n        List<List<Integer>> res = new ArrayList<>();\\n        int n = nums.length;\\n        if (n < 4) return res;\\n\\n        Arrays.sort(nums);\\n\\n        for (int i = 0; i < n - 3; i++) {\\n            if (i > 0 && nums[i] == nums[i - 1]) continue;\\n\\n            for (int j = i + 1; j < n - 2; j++) {\\n                if (j > i + 1 && nums[j] == nums[j - 1]) continue;\\n\\n                int left = j + 1;\\n                int right = n - 1;\\n\\n                while (left < right) {\\n                    long sum = (long) nums[i] + nums[j] + nums[left] + nums[right];\\n\\n                    if (sum == target) {\\n                        res.add(Arrays.asList(nums[i], nums[j], nums[left], nums[right]));\\n\\n                        left++;\\n                        right--;\\n\\n                        while (left < right && nums[left] == nums[left - 1]) left++;\\n                        while (left < right && nums[right] == nums[right + 1]) right--;\\n                    }\\n                    else if (sum < target) {\\n                        left++;\\n                    }\\n                    else {\\n                        right--;\\n                    }\\n                }\\n            }\\n        }\\n        return res;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"4sum","has_notes":false,"flag_type":1,"frontend_id":59},{"id":1871309107,"question_id":16,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 1\xc2\xa0week","timestamp":1767291962,"status":10,"status_display":"Accepted","runtime":"16 ms","url":"/submissions/detail/1871309107/","is_pending":"Not Pending","title":"3Sum Closest","memory":"45.3 MB","code":"class Solution {\\n    public int threeSumClosest(int[] nums, int target) {\\n        Arrays.sort(nums);\\n        int closest = nums[0] + nums[1] + nums[2];\\n\\n        for (int i = 0; i < nums.length - 2; i++) {\\n            int left = i + 1, right = nums.length - 1;\\n\\n            while (left < right) {\\n                int sum = nums[i] + nums[left] + nums[right];\\n\\n                if (Math.abs(sum - target) < Math.abs(closest - target)) {\\n                    closest = sum;\\n                }\\n\\n                if (sum < target) {\\n                    left++;\\n                } else if (sum > target) {\\n                    right--;\\n                } else {\\n                    return sum;   // exact hit, no need to dream further\\n                }\\n            }\\n        }\\n        return closest;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"3sum-closest","has_notes":false,"flag_type":1,"frontend_id":58},{"id":1871308728,"question_id":16,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 1\xc2\xa0week","timestamp":1767291941,"status":10,"status_display":"Accepted","runtime":"23 ms","url":"/submissions/detail/1871308728/","is_pending":"Not Pending","title":"3Sum Closest","memory":"45.6 MB","code":"class Solution {\\n    public int threeSumClosest(int[] nums, int target) {\\n        Arrays.sort(nums);\\n        int closest = nums[0] + nums[1] + nums[2];\\n\\n        for (int i = 0; i < nums.length - 2; i++) {\\n            int left = i + 1, right = nums.length - 1;\\n\\n            while (left < right) {\\n                int sum = nums[i] + nums[left] + nums[right];\\n\\n                if (Math.abs(sum - target) < Math.abs(closest - target)) {\\n                    closest = sum;\\n                }\\n\\n                if (sum < target) {\\n                    left++;\\n                } else if (sum > target) {\\n                    right--;\\n                } else {\\n                    return sum;   // exact hit, no need to dream further\\n                }\\n            }\\n        }\\n        return closest;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"3sum-closest","has_notes":false,"flag_type":1,"frontend_id":57},{"id":1869622925,"question_id":14,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 1\xc2\xa0week","timestamp":1767116570,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1869622925/","is_pending":"Not Pending","title":"Longest Common Prefix","memory":"43.1 MB","code":"class Solution {\\n    public String longestCommonPrefix(String[] strs) {\\n        if (strs == null || strs.length == 0) return \\"\\";\\n\\n        String prefix = strs[0];\\n\\n        for (int i = 1; i < strs.length; i++) {\\n            while (!strs[i].startsWith(prefix)) {\\n                prefix = prefix.substring(0, prefix.length() - 1);\\n                if (prefix.isEmpty()) return \\"\\";\\n            }\\n        }\\n\\n        return prefix;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-common-prefix","has_notes":false,"flag_type":1,"frontend_id":56},{"id":1868676871,"question_id":416,"lang":"java","lang_name":"Java","time":"7\xc2\xa0months, 1\xc2\xa0week","timestamp":1767030177,"status":10,"status_display":"Accepted","runtime":"32 ms","url":"/submissions/detail/1868676871/","is_pending":"Not Pending","title":"Partition Equal Subset Sum","memory":"43.7 MB","code":"class Solution {\\n    public boolean canPartition(int[] nums) {\\n        int sum = 0;\\n        for (int num : nums) {\\n            sum += num;\\n        }\\n\\n        if (sum % 2 != 0) return false;\\n\\n        int target = sum / 2;\\n\\n        boolean[] dp = new boolean[target + 1];\\n        dp[0] = true;\\n\\n        for (int num : nums) {\\n            for (int s = target; s >= num; s--) {\\n                dp[s] = dp[s] || dp[s - num];\\n            }\\n        }\\n\\n        return dp[target];\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"partition-equal-subset-sum","has_notes":false,"flag_type":1,"frontend_id":55}],"has_next":true,"last_key":""}'
