w int[n];\\n        int l = 0, r = n - 1, idx = n - 1;\\n\\n        while (l <= r) {\\n            if (Math.abs(nums[l]) > Math.abs(nums[r]))\\n                res[idx--] = nums[l] * nums[l++];\\n            else\\n                res[idx--] = nums[r] * nums[r--];\\n        }\\n        return res;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"squares-of-a-sorted-array","has_notes":false,"flag_type":1,"frontend_id":96},{"id":1888923211,"question_id":1045,"lang":"java","lang_name":"Java","time":"6\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1768744643,"status":10,"status_display":"Accepted","runtime":"11 ms","url":"/submissions/detail/1888923211/","is_pending":"Not Pending","title":"Check If Word Is Valid After Substitutions","memory":"46.6 MB","code":"class Solution {\\n    public boolean isValid(String s) {\\n        StringBuilder stack = new StringBuilder();\\n\\n        for (char ch : s.toCharArray()) {\\n            stack.append(ch);\\n\\n            int n = stack.length();\\n            if (n >= 3 &&\\n                stack.charAt(n - 3) == \'a\' &&\\n                stack.charAt(n - 2) == \'b\' &&\\n                stack.charAt(n - 1) == \'c\') {\\n                stack.delete(n - 3, n);\\n            }\\n        }\\n        return stack.length() == 0;\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"check-if-word-is-valid-after-substitutions","has_notes":false,"flag_type":1,"frontend_id":95}],"has_next":true,"last_key":""}'
