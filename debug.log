bottom && left <= right) {\\n            for (int i = left; i <= right; i++) {\\n                answer.add(matrix[top][i]);\\n            }\\n            top++;\\n            for (int i = top; i <= bottom; i++) {\\n                answer.add(matrix[i][right]);\\n            }\\n            right--;\\n            if (top <= bottom) {\\n                for (int i = right; i >= left; i--) {\\n                    answer.add(matrix[bottom][i]);\\n                }\\n                bottom--;\\n            }\\n            if (left <= right) {\\n                for (int i = bottom; i >= top; i--) {\\n                    answer.add(matrix[i][left]);\\n                }\\n                left++;\\n            }\\n        }\\n\\n        return answer;\\n    }\\n}","compare_result":"111111111111111111111111111","title_slug":"spiral-matrix","has_notes":false,"flag_type":1,"frontend_id":205},{"id":2071510669,"question_id":1496,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 2\xc2\xa0days","timestamp":1784314934,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2071510669/","is_pending":"Not Pending","title":"Lucky Numbers in a Matrix","memory":"47.3 MB","code":"class Solution {\\n    public List<Integer> luckyNumbers(int[][] matrix) {\\n        List<Integer> answer = new ArrayList<>();\\n        int rows = matrix.length;\\n        int cols = matrix[0].length;\\n        for (int i =0; i<rows; i++){\\n            for (int j =0; j<cols; j++) {\\n                boolean isRowMinimum = true;\\n                for (int k =0; k<cols; k++) {\\n                    if (matrix[i][k] < matrix[i][j]) {\\n                        isRowMinimum = false;\\n                        break;\\n                    }\\n                }\\n                boolean isColumnMaximum = true;\\n                for (int k =0; k<rows; k++) {\\n                    if (matrix[k][j] >matrix[i][j]) {\\n                        isColumnMaximum = false;\\n                        break;\\n                    }\\n                }\\n                if (isRowMinimum && isColumnMaximum) {\\n                    answer.add(matrix[i][j]);\\n                }\\n            }\\n        }\\n        return answer;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"lucky-numbers-in-a-matrix","has_notes":false,"flag_type":1,"frontend_id":204},{"id":2071496417,"question_id":1677,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 2\xc2\xa0days","timestamp":1784313902,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2071496417/","is_pending":"Not Pending","title":"Matrix Diagonal Sum","memory":"46.4 MB","code":"class Solution {\\n    public int diagonalSum(int[][] mat) {\\n        int n=mat.length;\\n        int sum=0;\\n\\n        for (int i =0; i<n; i++) {\\n            for (int j =0; j<n; j++){\\n                if (i==j) {\\n                    sum +=mat[i][j];\\n                }\\n                if (i+j == n-1) {\\n                    sum += mat[i][j];\\n                }\\n            }\\n        }\\n        if (n%2 ==1) {\\n            sum -= mat[n/2][n/2];\\n        }\\n        return sum;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"matrix-diagonal-sum","has_notes":false,"flag_type":1,"frontend_id":203},{"id":2070344843,"question_id":566,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1784229117,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2070344843/","is_pending":"Not Pending","title":"Reshape the Matrix","memory":"47.5 MB","code":"class Solution {\\n\\n    public int[][] matrixReshape(int[][] mat, int r, int c) {\\n\\n        int row = mat.length;\\n        int col = mat[0].length;\\n\\n        if (row * col != r * c) {\\n            return mat;\\n        }\\n\\n        int[][] answer = new int[r][c];\\n\\n        int newRow = 0;\\n        int newCol = 0;\\n\\n        for (int i = 0; i < row; i++) {\\n\\n            for (int j = 0; j < col; j++) {\\n\\n                answer[newRow][newCol] = mat[i][j];\\n\\n                newCol++;\\n\\n                if (newCol == c) {\\n                    newRow++;\\n                    newCol = 0;\\n                }\\n            }\\n        }\\n\\n        return answer;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111","title_slug":"reshape-the-matrix","has_notes":false,"flag_type":1,"frontend_id":202},{"id":2069042438,"question_id":88,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 4\xc2\xa0days","timestamp":1784140823,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2069042438/","is_pending":"Not Pending","title":"Merge Sorted Array","memory":"43.7 MB","code":"class Solution {\\n    public void merge(int[] nums1, int m, int[] nums2, int n) {\\n      int i = m-1;\\n      int j = n-1;\\n      int k = m+n-1;\\n      while (i>=0 && j>=0) {\\n        if (nums1[i] > nums2[j]) {\\n            nums1[k] = nums1[i];\\n            i--;\\n        } else {\\n            nums1[k] = nums2[j];\\n            j--;\\n        }\\n        k--;\\n      }  \\n      while (j >=0) {\\n        nums1[k]= nums2[j];\\n        j--;\\n        k--;\\n      }\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-sorted-array","has_notes":false,"flag_type":1,"frontend_id":201},{"id":2069040780,"question_id":88,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 4\xc2\xa0days","timestamp":1784140728,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2069040780/","is_pending":"Not Pending","title":"Merge Sorted Array","memory":"N/A","code":"class Solution {\\n    public void merg