":false,"flag_type":1,"frontend_id":153},{"id":1980253648,"question_id":1,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1776358455,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1980253648/","is_pending":"Not Pending","title":"Two Sum","memory":"47 MB","code":"class Solution {\\n    public int[] twoSum(int[] nums, int target) {\\n      HashMap<Integer, Integer> map = new HashMap<>();\\n      for (int i = 0; i<nums.length; i++) {\\n        int required = target - nums[i];\\n         if (map.containsKey(required)) {\\n            return new int[]{map.get(required),i};\\n        }\\n        map.put(nums[i], i);\\n      }\\n      return new int[]{};\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111","title_slug":"two-sum","has_notes":false,"flag_type":1,"frontend_id":152},{"id":1965766837,"question_id":239,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1775041885,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1965766837/","is_pending":"Not Pending","title":"Sliding Window Maximum","memory":"N/A","code":"class Solution {\\n    public int[] maxSlidingWindow(int[] nums, int k) {\\n        int n = nums.length;\\n        int[] result = new int[n - k + 1];\\n        for (int i = 0; i <= n - k; i++) {\\n            int max = nums[i];\\n            for (int j = i; j < i + k; j++) {\\n                if (nums[j] > max) {\\n                    max = nums[j];\\n                }\\n            }\\n            result[i] = max;\\n        }\\n        return result;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111110000000","title_slug":"sliding-window-maximum","has_notes":false,"flag_type":1,"frontend_id":151},{"id":1958759380,"question_id":496,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1774435689,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1958759380/","is_pending":"Not Pending","title":"Next Greater Element I","memory":"45.4 MB","code":"class Solution {\\n    public int[] nextGreaterElement(int[] nums1, int[] nums2) {\\n        Stack<Integer> stack = new Stack<>();\\n        Map<Integer, Integer> map = new HashMap<>();\\n        for (int num : nums2) {\\n            while (!stack.isEmpty() && num > stack.peek()) {\\n                map.put(stack.pop(), num);\\n            }\\n            stack.push(num);\\n        }\\n        while (!stack.isEmpty()) {\\n            map.put(stack.pop(), -1);\\n        }\\n        int[] ans = new int[nums1.length];\\n        for (int i = 0; i < nums1.length; i++) {\\n            ans[i] = map.get(nums1[i]);\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"11111111111111111","title_slug":"next-greater-element-i","has_notes":false,"flag_type":1,"frontend_id":150},{"id":1951820443,"question_id":162,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1773814797,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1951820443/","is_pending":"Not Pending","title":"Find Peak Element","memory":"44 MB","code":"class Solution {\\n    public int findPeakElement(int[] nums) {\\n        int low = 0;\\n        int high = nums.length - 1;\\n        while (low < high) {\\n            int mid = (low + high) / 2;\\n            if (nums[mid] > nums[mid + 1]) {\\n                high = mid;\\n            } else {\\n                low = mid + 1;\\n            }\\n        }\\n        return low;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-peak-element","has_notes":false,"flag_type":1,"frontend_id":149},{"id":1944916090,"question_id":5,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1773226825,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/1944916090/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"43.6 MB","code":"class Solution {\\n    public String longestPalindrome(String s) {\\n        int start = 0, end = 0;\\n        for (int i = 0; i < s.length(); i++) {\\n            int len1 = expand(s, i, i);  \\n            int len2 = expand(s, i, i + 1);\\n            int len = Math.max(len1, len2);\\n            if (len > end - start) {\\n                start = i - (len - 1) / 2;\\n                end = i + len / 2;\\n            }\\n        }\\n        return s.substring(start, end + 1);\\n    }\\n    int expand(String s, int left, int right) {\\n        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {\\n            left--;\\n            right++;\\n        }\\n        return right - left - 1;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":148},{"id":1930673659,"question_id":338,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1772015450,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1930673659/","is_pending":"Not Pending","title":"Counting Bits","memory":"49 MB","code":"class Solution {\\n    public int[] countBits(int n) {\\n        int[] dp = new int[n+1];\\n        for (int i = 1; i<=n; i++){\\n            dp[i] = dp[i>>1]+(i&1);\\n        }\\n        return dp;\\n    }\\n}","compare_result":"111111111111111","title_slug":"counting-bits","has_notes":false,"flag_type":1,"frontend_id":147},{"id":1930482019,"question_id":2150,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1772002360,"status":10,"status_display":"Accepted","runtime":"736 ms","url":"/submissions/detail/1930482019/","is_pending":"Not Pending","title":"Kth Smallest Product of Two Sorted Arrays","memory":"62.8 MB","code":"class Solution {\\n    public long kthSmallestProduct(int[] nums1, int[] nums2, long k) {\\n        long left = -10000000000L;\\n        long right = 10000000000L;\\n        while (left < right) {\\n            long mid = left + (right - left) / 2;\\n            long cnt = count(nums1, nums2, mid);\\n            if (cnt >= k) {\\n                right = mid;\\n            } else {\\n                left = mid + 1;\\n            }\\n        }\\n        return left;\\n    }\\n    public long count(int[] nums1, int[] nums2, long target) {\\n        long count = 0;\\n        for (int i = 0; i < nums1.length; i++) {\\n            int a = nums1[i];\\n            if (a > 0) {\\n                int l = 0, r = nums2.length - 1;\\n                while (l <= r) {\\n                    int mid = l + (r - l) / 2;\\n                    if ((long) a * nums2[mid] <= target) {\\n                        l = mid + 1;\\n                    } else {\\n                        r = mid - 1;\\n                    }\\n                }\\n                count += l;\\n            } else if (a < 0) {\\n                int l = 0, r = nums2.length - 1;\\n                while (l <= r) {\\n                    int mid = l + (r - l) / 2;\\n                    if ((long) a * nums2[mid] <= target) {\\n                        r = mid - 1;\\n                    } else {\\n                        l = mid + 1;\\n                    }\\n                }\\n               count += nums2.length - l;\\n            } else { \\n                if (target >= 0) {\\n                    count += nums2.length;\\n                }\\n            }\\n        }\\n        return count;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"kth-smallest-product-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":146},{"id":1930477298,"question_id":53,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1772002078,"status":20,"status_display":"Compile Error","runtime":"N/A","url":"/submissions/detail/1930477298/","is_pending":"Not Pending","title":"Maximum Subarray","memory":"N/A","code":"class Solution {\\n    public int maxSubArray(int[] nums) {\\n        int currentSum = nums[0];\\n        int maxSum = nums[0]\\n        for (int i = 1; i < nums.length; i++) {\\n            currentSum = Math.max(nums[i], currentSum + nums[i]);\\n            maxSum = Math.max(maxSum, currentSum);\\n        }\\n        return maxSum;\\n    }\\n}","compare_result":null,"title_slug":"maximum-subarray","has_notes":false,"flag_type":1,"frontend_id":145},{"id":1929945479,"question_id":643,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771954448,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1929945479/","is_pending":"Not Pending","title":"Maximum Average Subarray I","memory":"69.8 MB","code":"class Solution {\\n    public double findMaxAverage(int[] nums, int k) {\\n        int sum = 0;\\n        for(int i = 0; i < k; i++) {\\n            sum += nums[i];\\n        } \\n        int maxSum = sum;\\n        for(int i = k; i < nums.length; i++) {\\n            sum = sum - nums[i - k] + nums[i];\\n            maxSum = Math.max(maxSum, sum);\\n        }\\n        \\n        return (double) maxSum / k;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-average-subarray-i","has_notes":false,"flag_type":1,"frontend_id":144},{"id":1929942703,"question_id":121,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771954320,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1929942703/","is_pending":"Not Pending","title":"Best Time to Buy and Sell Stock","memory":"94.5 MB","code":"class Solution {\\n    public int maxProfit(int[] prices) {\\n\\n        int minPrice = prices[0];\\n        int maxProfit = 0;\\n\\n        for(int i = 1; i < prices.length; i++) {\\n\\n            if(prices[i] < minPrice) {\\n                minPrice = prices[i];\\n            } else {\\n                int profit = prices[i] - minPrice;\\n                if(profit > maxProfit) {\\n                    maxProfit = profit;\\n                }\\n            }\\n        }\\n\\n        return maxProfit;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"best-time-to-buy-and-sell-stock","has_notes":false,"flag_type":1,"frontend_id":143},{"id":1928871211,"question_id":1791,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771871032,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1928871211/","is_pending":"Not Pending","title":"Richest Customer Wealth","memory":"44.7 MB","code":"class Solution {\\n    public int maximumWealth(int[][] accounts) {\\n        int maxWealth = 0;\\n\\n        for (int[] customer : accounts) {\\n            int sum = 0;\\n            for (int money : customer) {\\n                sum += money;\\n            }\\n            maxWealth = Math.max(maxWealth, sum);\\n        }\\n\\n        return maxWealth;\\n    }\\n}","compare_result":"1111111111111111111111111111111111","title_slug":"richest-customer-wealth","has_notes":false,"flag_type":1,"frontend_id":142},{"id":1928811271,"question_id":1421,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771868145,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1928811271/","is_pending":"Not Pending","title":"Find Numbers with Even Number of Digits","memory":"44.6 MB","code":"class Solution {\\n    public int findNumbers(int[] nums) {\\n        int count = 0;\\n\\n        for (int num : nums) {\\n            int digits = 0;\\n\\n            if (num < 0) {\\n                num = -num;\\n            }\\n\\n            if (num == 0) {\\n                digits = 1;\\n            } else {\\n                while (num > 0) {\\n                    digits++;\\n                    num /= 10;\\n                }\\n            }\\n\\n            if (digits % 2 == 0) {\\n                count++;\\n            }\\n        }\\n\\n        return count;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-numbers-with-even-number-of-digits","has_notes":false,"flag_type":1,"frontend_id":141},{"id":1927618651,"question_id":76,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771778154,"status":10,"status_display":"Accepted","runtime":"21 ms","url":"/submissions/detail/1927618651/","is_pending":"Not Pending","title":"Minimum Window Substring","memory":"48 MB","code":"class Solution {\\n    public String minWindow(String s, String t) {\\n        if (s.length() == 0 || t.length() == 0)\\n            return \\"\\";\\n\\n        Map<Character, Integer> map = new HashMap<>();\\n        for (char c : t.toCharArray()) {\\n            map.put(c, map.getOrDefault(c, 0) + 1);\\n        }\\n\\n        int left = 0, right = 0;\\n        int formed = 0;\\n        int required = map.size();\\n\\n        Map<Character, Integer> windowMap = new HashMap<>();\\n\\n        int minLen = Integer.MAX_VALUE;\\n        int start = 0;\\n\\n        while (right < s.length()) {\\n\\n            char c = s.charAt(right);\\n            windowMap.put(c, windowMap.getOrDefault(c, 0) + 1);\\n\\n            if (map.containsKey(c) &&\\n                windowMap.get(c).intValue() == map.get(c).intValue()) {\\n                formed++;\\n            }\\n\\n            while (left <= right && formed == required) {\\n\\n                if (right - left + 1 < minLen) {\\n                    minLen = right - left + 1;\\n                    start = left;\\n                }\\n\\n                char leftChar = s.charAt(left);\\n                windowMap.put(leftChar, windowMap.get(leftChar) - 1);\\n\\n                if (map.containsKey(leftChar) &&\\n                    windowMap.get(leftChar) < map.get(leftChar)) {\\n                    formed--;\\n                }\\n\\n                left++;\\n            }\\n\\n            right++;\\n        }\\n\\n        return minLen == Integer.MAX_VALUE ? \\"\\" :\\n               s.substring(start, start + minLen);\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-window-substring","has_notes":false,"flag_type":1,"frontend_id":140},{"id":1926588247,"question_id":767,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1771695998,"status":10,"status_display":"Accepted","runtime":"9 ms","url":"/submissions/detail/1926588247/","is_pending":"Not Pending","title":"Prime Number of Set Bits in Binary Representation","memory":"42.3 MB","code":"class Solution {\\n    public int countPrimeSetBits(int left, int right) {\\n        int count = 0;\\n        Set<Integer> primes = Set.of(2,3,5,7,11,13,17,19);\\n        for(int i = left; i <= right; i++){\\n            int bits = Integer.bitCount(i);  \\n            if(primes.contains(bits)){\\n                count++;\\n            }\\n        }\\n        return count;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"prime-number-of-set-bits-in-binary-representation","has_notes":null,"flag_type":1,"frontend_id":139},{"id":1924677965,"question_id":169,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1771524159,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1924677965/","is_pending":"Not Pending","title":"Majority Element","memory":"56 MB","code":"class Solution {\\n    public int majorityElement(int[] nums) {\\n        int candidate = 0;\\n        int count = 0;\\n\\n        for (int num : nums) {\\n            if (count == 0) {\\n                candidate = num;\\n            }\\n            if (num == candidate) {\\n                count++;\\n            }\\n            else \\n            {\\n                count--;\\n        }\\n    }\\n    return candidate;\\n}\\n}","compare_result":"11111111111111111111111111111111111111111111111111111","title_slug":"majority-element","has_notes":false,"flag_type":1,"frontend_id":138},{"id":1923547984,"question_id":219,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1771435489,"status":10,"status_display":"Accepted","runtime":"23 ms","url":"/submissions/detail/1923547984/","is_pending":"Not Pending","title":"Contains Duplicate II","memory":"90.6 MB","code":"class Solution {\\n    public boolean containsNearbyDuplicate(int[] nums, int k) {\\n        HashMap<Integer, Integer> map = new HashMap<>();\\n        for (int i = 0; i< nums.length; i++) {\\n            if (map.containsKey(nums[i])){\\n                int prevIndex = map.get(nums[i]);\\n                if(i - prevIndex <=k){\\n                    return true;\\n                }\\n            }\\n            map.put(nums[i], i);\\n        }\\n        return false;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"contains-duplicate-ii","has_notes":false,"flag_type":1,"frontend_id":137},{"id":1923484005,"question_id":66,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1771432436,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1923484005/","is_pending":"Not Pending","title":"Plus One","memory":"43.4 MB","code":"class Solution {\\n    public int[] plusOne(int[] digits) {\\n        for (int i = digits.length - 1; i>=0; i--){\\n            if(digits[i]!=9){\\n                digits[i]++;\\n                return digits;\\n            }\\n            digits[i]=0;\\n        }\\n        int[] newArr = new int[digits.length+1];\\n        newArr[0] = 1;\\n        return newArr;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"plus-one","has_notes":false,"flag_type":1,"frontend_id":136},{"id":1922471819,"question_id":153,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1771351315,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1922471819/","is_pending":"Not Pending","title":"Find Minimum in Rotated Sorted Array","memory":"43.7 MB","code":"class Solution {\\n    public int findMin(int[] nums) {\\n        int left = 0;\\n        int right = nums.length - 1;\\n\\n        if (nums[left] <= nums[right]) {\\n            return nums[left];\\n        }\\n\\n        while (left < right) {\\n            int mid = left + (right - left) / 2;\\n\\n            if (nums[mid] > nums[right]) {\\n                left = mid + 1;\\n            } else {\\n                right = mid;\\n            }\\n        }\\n\\n        return nums[left];\\n    }\\n}\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-minimum-in-rotated-sorted-array","has_notes":false,"flag_type":1,"frontend_id":135}],"has_next":true,"last_key":""}'
